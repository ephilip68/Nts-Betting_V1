<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Nouveau message de contact — NTS Betting</title>
</head>
<body style="margin:0; padding:0; background:#020b14; font-family:Arial, Helvetica, sans-serif; color:#e5e7eb;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#020b14;">
    <tr>
        <td align="center" style="padding:40px 20px;">
            <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background:#061522; border:1px solid #263b4d; border-radius:8px; overflow:hidden;">
                <tr>
                    <td style="padding:28px 30px; background:#030f1b; border-bottom:1px solid #263b4d;">
                        <strong style="color:#DDB219; font-size:16px;">NTS Betting — Nouveau message de contact</strong>
                    </td>
                </tr>
                <tr>
                    <td style="padding:30px;">
                        <p style="margin:0 0 8px;"><strong style="color:#fff;">De :</strong> {{ name }} ({{ senderEmail }})</p>
                        <p style="margin:0 0 20px;"><strong style="color:#fff;">Sujet :</strong> {{ subject }}</p>
                        <div style="background:#0a1b29; border:1px solid #35495a; border-radius:4px; padding:16px; white-space:pre-wrap; color:#aebbc7; font-size:14px; line-height:1.6;">{{ messageContent }}</div>
                        <p style="margin:20px 0 0; color:#7f909f; font-size:12px;">Réponds directement à cet e-mail pour contacter {{ name }}.</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
