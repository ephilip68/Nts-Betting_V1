<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ subject }}</title>
</head>
<body style="margin:0; padding:0; background:#020b14; font-family:Arial, Helvetica, sans-serif; color:#e5e7eb;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#020b14;">
    <tr>
        <td align="center" style="padding:40px 20px;">
            <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background:#061522; border:1px solid #263b4d; border-radius:8px; overflow:hidden;">

                <tr>
                    <td align="center" style="padding:28px 30px; background:#030f1b; border-bottom:1px solid #263b4d;">
                        <img src="{{ absolute_url(asset('images/logo/logo.png')) }}" alt="NTS Betting" width="110" style="display:block; width:110px; max-width:110px; height:auto; border:0;">
                    </td>
                </tr>

                <tr>
                    <td style="padding:35px 30px; color:#d7e0e8; font-size:14px; line-height:1.7;">
                        {{ contentHtml|raw }}
                    </td>
                </tr>

                <tr>
                    <td align="center" style="padding:22px 30px; background:#030f1b; border-top:1px solid #263b4d;">
                        <p style="margin:0 0 6px; color:#667887; font-size:10px;">
                            © {{ "now"|date("Y") }} NTS Betting. Tous droits réservés.
                        </p>
                        <p style="margin:0; color:#4f6170; font-size:10px;">
                            Tu reçois cet e-mail car tu es inscrit(e) à la newsletter NTS Betting.
                            <a href="{{ unsubscribeUrl }}" style="color:#8a9aa8;">Se désinscrire</a>
                        </p>
                    </td>
                </tr>

            </table>
        </td>
    </tr>
</table>
</body>
</html>
