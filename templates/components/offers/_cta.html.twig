{# =========================================================
   NTS BETTING — CTA OFFRES
   ========================================================= #}

<section class="offers-cta">

    <div class="offers-cta__overlay"></div>

    <div class="offers-cta__container">

        <div class="offers-cta__content">

            <h2 class="offers-cta__title">
                Prêt à passer au niveau supérieur ?
            </h2>

            <p class="offers-cta__text">
                Rejoignez dès maintenant des milliers de parieurs
                et accédez à des analyses de qualité.
            </p>

        </div>

        {% if app.user %}
            <a href="{{ path('app_dashboard') }}" class="offers-cta__button">
                <span>Accéder à mon tableau de bord</span>
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        {% else %}
            <a href="{{ path('app_register') }}" class="offers-cta__button">
                <span>S'inscrire maintenant</span>
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        {% endif %}

    </div>

</section>