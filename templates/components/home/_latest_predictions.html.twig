{# =========================================================
   NTS BETTING — DERNIERS PRONOSTICS
   ========================================================= #}

<section class="latest-predictions-section">

    <div class="latest-predictions-container">

        {# -----------------------------------------------------
           EN-TÊTE
           ----------------------------------------------------- #}

        <div class="latest-predictions-header">

            <div class="latest-predictions-heading">

                <span class="latest-predictions-eyebrow">
                    Derniers pronostics
                </span>

                <h2 class="latest-predictions-title">
                    Nos derniers résultats
                </h2>

                <p class="latest-predictions-description">
                    Un suivi transparent pour une confiance totale.
                </p>

            </div>

            <a href="{{ path('app_results') }}" class="latest-predictions-link">
                Voir tous les résultats
                <span class="latest-predictions-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path
                            d="M5 12H19M13 6L19 12L13 18"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </span>
            </a>

        </div>


        {# -----------------------------------------------------
           CARTES
           ----------------------------------------------------- #}

        <div class="latest-predictions-grid">

            {% for pronostic in latestResults %}

                {% set won = pronostic.status == 'won' %}

                <article class="prediction-card">

                    <div class="prediction-card-top">

                        <div class="prediction-card-meta">

                            <span class="prediction-card-date">
                                {{ pronostic.matchDate|date('d M. Y') }}
                            </span>

                            <span class="prediction-card-competition">
                                {{ pronostic.competition }}
                            </span>

                        </div>

                        <span class="prediction-card-sport" aria-label="{{ pronostic.sport }}">
                            {% if pronostic.sport == 'basketball' %}🏀{% elseif pronostic.sport == 'tennis' %}🎾{% else %}⚽{% endif %}
                        </span>

                    </div>


                    <div class="prediction-card-match">

                        <strong class="prediction-card-teams">
                            {{ pronostic.teamHome }} vs {{ pronostic.teamAway }}
                        </strong>

                        <span class="prediction-card-prediction">
                            {{ pronostic.betType }} - {{ pronostic.betValue }}
                        </span>

                    </div>


                    <div class="prediction-card-footer">

                        <span class="prediction-card-status {{ won ? 'prediction-card-status-win' : 'prediction-card-status-loss' }}">
                            <span aria-hidden="true">{{ won ? '✓' : '✗' }}</span>
                            {{ won ? 'Gagné' : 'Perdu' }}
                        </span>

                        <strong class="prediction-card-odds">
                            {{ pronostic.odds|odds }}
                        </strong>

                    </div>

                </article>

            {% else %}

                <p style="color:rgba(255,255,255,0.5);">Aucun résultat pour le moment.</p>

            {% endfor %}

        </div>

    </div>

</section>