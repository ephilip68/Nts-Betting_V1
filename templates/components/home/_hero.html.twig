<section class="hero">

    {# =========================================================
       BACKGROUND
       ========================================================= #}
    <div class="hero-background" aria-hidden="true">
        <div class="hero-background-image"></div>
        <div class="hero-background-overlay"></div>
        <div class="hero-background-vignette"></div>
    </div>


    {# =========================================================
       CONTENU PRINCIPAL
       ========================================================= #}
    <div class="hero-container">

        {# -----------------------------------------------------
           CONTENU GAUCHE
           ----------------------------------------------------- #}
        <div class="hero-content">

            <span class="hero-kicker">
                ANALYSES. DISCIPLINE. RÉSULTATS.
            </span>

            <h1 class="hero-brand">
                <span>NTS</span>
                <strong>BETTING</strong>
            </h1>

            <p class="hero-description">
                Des pronostics fiables, une approche sérieuse,<br>
                une communauté de passionnés.
            </p>


            {# Avantages #}
            <ul class="hero-features">

                <li>
                    <span class="hero-feature-icon" aria-hidden="true">✓</span>
                    <span>Analyses approfondies</span>
                </li>

                <li>
                    <span class="hero-feature-icon" aria-hidden="true">✓</span>
                    <span>Communauté active</span>
                </li>

                <li>
                    <span class="hero-feature-icon" aria-hidden="true">✓</span>
                    <span>Suivi transparent</span>
                </li>

                <li>
                    <span class="hero-feature-icon" aria-hidden="true">✓</span>
                    <span>Résultats vérifiés</span>
                </li>

            </ul>


            {# CTA #}
            <div class="hero-actions">

                <a href="{{ path('app_offers') }}" class="hero-btn hero-btn-primary">
                    <span>Découvrir nos offres</span>

                    <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M4 10H15M10.5 5.5L15 10L10.5 14.5"/>
                    </svg>
                </a>

            </div>


            {# Membres #}
            <div class="hero-members">

                <div class="hero-members-avatars">

                    <span class="hero-member-avatar">N</span>
                    <span class="hero-member-avatar">S</span>
                    <span class="hero-member-avatar">M</span>
                    <span class="hero-member-avatar">A</span>

                </div>

                <span class="hero-members-text">
                    {{ activeMembersCount }} membre{{ activeMembersCount > 1 ? 's' : '' }} {{ activeMembersCount > 1 ? 'nous font' : 'nous fait' }} confiance
                </span>

            </div>

        </div>


        {# -----------------------------------------------------
           CARTE RÉSULTATS
           ----------------------------------------------------- #}
        <aside class="hero-results">

            <div class="hero-results-heading">
                <span>NOS RÉSULTATS</span>
                <small>(30 DERNIERS JOURS)</small>
            </div>


            <div class="hero-results-grid">

                {# Taux de réussite #}
                <div class="hero-result-card">

                    <div class="hero-result-top">

                        <div class="hero-result-icon hero-result-icon-success">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="10" r="5"/>
                                <path d="M9 15L8 21L12 18L16 21L15 15"/>
                            </svg>
                        </div>

                        <div class="hero-result-number">
                            <strong>{{ heroStats.winRate is not null ? heroStats.winRate ~ '%' : '—' }}</strong>
                            <span class="hero-result-number-line"></span>
                        </div>
                    </div>

                    <span class="hero-result-label">
                        Taux de réussite
                    </span>

                </div>


                {# Unités gagnées #}
                <div class="hero-result-card">

                    <div class="hero-result-top">

                        <div class="hero-result-icon hero-result-icon-profit">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M5 16L10 11L13 14L19 7"/>
                                <path d="M14 7H19V12"/>
                            </svg>
                        </div>

                        <div class="hero-result-number">
                            <strong>{{ heroStats.unitsProfit > 0 ? '+' : '' }}{{ heroStats.unitsProfit }} €</strong>
                            <span class="hero-result-number-line"></span>
                        </div>

                    </div>

                    <span class="hero-result-label">
                        Gains cumulés
                    </span>

                </div>


                {# Paris analysés #}
                <div class="hero-result-card">

                    <div class="hero-result-top">

                        <div class="hero-result-icon hero-result-icon-bets">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M7 12.5L10.2 15.5L17.5 8"/>
                            </svg>
                        </div>

                        <div class="hero-result-number">
                            <strong>{{ heroStats.settledCount }}</strong>
                            <span class="hero-result-number-line"></span>
                        </div>

                    </div>

                    <span class="hero-result-label">
                        Paris analysés
                    </span>

                </div>


                {# Membres actifs #}
                <div class="hero-result-card">

                    <div class="hero-result-top">

                        <div class="hero-result-icon hero-result-icon-members">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="9" cy="8.5" r="3"/>
                                <circle cx="16.5" cy="10" r="2.5"/>
                                <path d="M4 19C4.5 15.8 6.2 14 9 14C11.8 14 13.5 15.8 14 19"/>
                                <path d="M14 15C16.5 13.8 19.2 15.2 20 18"/>
                            </svg>
                        </div>

                        <div class="hero-result-number">
                            <strong>{{ activeMembersCount }}</strong>
                            <span class="hero-result-number-line"></span>
                        </div>

                    </div>

                    <span class="hero-result-label">
                        Membres actifs
                    </span>

                </div>

            </div>


            {# Citation #}
            <div class="hero-results-quote">

                <div class="hero-results-quote-content">
                    <p>
                        « La réussite ne vient pas du hasard,
                        mais d'une méthode. »
                    </p>

                    <span>NTS Betting</span>
                </div>


                {# Couronne décorative #}
                <div class="hero-results-crown" aria-hidden="true">

                <svg viewBox="0 0 100 76" xmlns="http://www.w3.org/2000/svg">

                    <path
                        d="M8 15L27 32L40 8L50 32L63 8L76 32L92 15L84 62H16L8 15Z"
                        fill="currentColor"
                    />

                    <path
                        d="M16 62H84"
                        fill="currentColor"
                    />

                    <circle cx="8" cy="15" r="4" fill="currentColor"/>
                    <circle cx="40" cy="8" r="4" fill="currentColor"/>
                    <circle cx="63" cy="8" r="4" fill="currentColor"/>
                    <circle cx="92" cy="15" r="4" fill="currentColor"/>

                </svg>

            </div>

            </div>

        </aside>

    </div>


