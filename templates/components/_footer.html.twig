{# =========================================================
   NTS BETTING — FOOTER PREMIUM
   ========================================================= #}

<footer class="site-footer">

    {# =====================================================
       FOOTER PRINCIPAL
       ===================================================== #}

    <div class="site-footer__main">

        <div class="site-footer__container">


            {# =================================================
               IDENTITÉ / LOGO
               ================================================= #}

            <div class="site-footer__brand">

                <a
                    href="{{ path('app_home') }}"
                    class="site-footer__logo"
                >
                    <img
                        src="{{ asset('images/logo/logo.png') }}"
                        alt="NTS Betting"
                    >
                </a>

                <p class="site-footer__description">
                    Plus qu'un simple site de pronostics,
                    une vraie communauté.
                </p>


                {# =================================================
                AVANTAGES / ENGAGEMENTS
                ================================================= #}

                <div class="site-footer__features">

                    {# -------------------------------------------------
                    COMMUNAUTÉ
                    ------------------------------------------------- #}

                    <div class="site-footer__feature">

                        <div class="site-footer__feature-icon">
                            <i class="fa-solid fa-users"></i>
                        </div>

                        <div class="site-footer__feature-content">
                            <span>Une communauté</span>
                            <span>active</span>
                        </div>

                    </div>


                    {# -------------------------------------------------
                    ANALYSES
                    ------------------------------------------------- #}

                    <div class="site-footer__feature">

                        <div class="site-footer__feature-icon">
                            <i class="fa-solid fa-chart-column"></i>
                        </div>

                        <div class="site-footer__feature-content">
                            <span>Des analyses</span>
                            <span>de qualité</span>
                        </div>

                    </div>


                    {# -------------------------------------------------
                    JEU RESPONSABLE
                    ------------------------------------------------- #}

                    <div class="site-footer__feature">

                        <div class="site-footer__feature-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>

                        <div class="site-footer__feature-content">
                            <span>Un jeu</span>
                            <span>responsable</span>
                        </div>

                    </div>

                </div>

            </div>


            {# =================================================
               LIENS RAPIDES
               ================================================= #}

            <div class="site-footer__column">

                <h3 class="site-footer__title">
                    Liens rapides
                </h3>

                <nav class="site-footer__links">

                    <a href="{{ path('app_home') }}">
                        <i class="fa-solid fa-chevron-right"></i>
                        Accueil
                    </a>

                    <a href="{{ path('app_offers') }}">
                        <i class="fa-solid fa-chevron-right"></i>
                        Nos offres
                    </a>

                    <a href="{{ path('app_results') }}">
                        <i class="fa-solid fa-chevron-right"></i>
                        Résultats
                    </a>

                    <a href="{{ path('app_vault') }}">
                        <i class="fa-solid fa-chevron-right"></i>
                        NTS Vault
                    </a>

                    <a href="{{ path('app_about') }}">
                        <i class="fa-solid fa-chevron-right"></i>
                        À propos
                    </a>

                    <a href="{{ path('app_faq') }}">
                        <i class="fa-solid fa-chevron-right"></i>
                        FAQ
                    </a>

                    <a href="{{ path('app_contact') }}">
                        <i class="fa-solid fa-chevron-right"></i>
                        Contact
                    </a>

                </nav>

            </div>


            {# =================================================
               LÉGAL
               ================================================= #}

            <div class="site-footer__column site-footer__legal">

                <h3 class="site-footer__title">
                    Légal
                </h3>

                <nav class="site-footer__links">

                    <a href="{{ path('app_terms') }}">
                        <i class="fa-solid fa-chevron-right"></i>
                        Conditions d'utilisation
                    </a>

                    <a href="{{ path('app_privacy_policy') }}">
                        <i class="fa-solid fa-chevron-right"></i>
                        Politique de confidentialité
                    </a>

                    <a href="{{ path('app_legal_notice') }}">
                        <i class="fa-solid fa-chevron-right"></i>
                        Mentions légales
                    </a>

                    <a href="{{ path('app_responsible_gaming') }}">
                        <i class="fa-solid fa-chevron-right"></i>
                        Jeu responsable
                    </a>

                </nav>

            </div>


            {# =================================================
               RÉSEAUX SOCIAUX
               ================================================= #}

            <div class="site-footer__column site-footer__social">

                <h3 class="site-footer__title">
                    Suivez-nous
                </h3>

                {% set settings = site_settings() %}

                <div class="site-footer__social-links">

                    {% if settings.telegramUrl %}
                        <a href="{{ settings.telegramUrl }}" target="_blank" rel="noopener" class="site-footer__social-link" aria-label="Telegram">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">
                                <path d="M29.919 6.163l-4.225 19.925c-0.319 1.406-1.15 1.756-2.331 1.094l-6.438-4.744-3.106 2.988c-0.344 0.344-0.631 0.631-1.294 0.631l0.463-6.556 11.931-10.781c0.519-0.462-0.113-0.719-0.806-0.256l-14.75 9.288-6.35-1.988c-1.381-0.431-1.406-1.381 0.288-2.044l24.837-9.569c1.15-0.431 2.156 0.256 1.781 2.013z"/>
                            </svg>
                        </a>
                    {% endif %}

                    {% if settings.twitterUrl %}
                        <a href="{{ settings.twitterUrl }}" target="_blank" rel="noopener" class="site-footer__social-link" aria-label="Twitter">
                            <i class="fa-brands fa-x-twitter"></i>
                        </a>
                    {% endif %}

                    {% if settings.instagramUrl %}
                        <a href="{{ settings.instagramUrl }}" target="_blank" rel="noopener" class="site-footer__social-link" aria-label="Instagram">
                            <i class="fa-brands fa-instagram"></i>
                        </a>
                    {% endif %}

                    {% if settings.youtubeUrl %}
                        <a href="{{ settings.youtubeUrl }}" target="_blank" rel="noopener" class="site-footer__social-link" aria-label="YouTube">
                            <i class="fa-brands fa-youtube"></i>
                        </a>
                    {% endif %}

                </div>


                {# =================================================
                   NEWSLETTER / INFORMATION
                   ================================================= #}

                {% for message in app.flashes('newsletter_success') %}
                    <p class="site-footer__newsletter-flash site-footer__newsletter-flash--success">{{ message }}</p>
                {% endfor %}
                {% for message in app.flashes('newsletter_error') %}
                    <p class="site-footer__newsletter-flash site-footer__newsletter-flash--error">{{ message }}</p>
                {% endfor %}

                <form class="site-footer__newsletter" action="{{ path('app_newsletter_subscribe') }}" method="post">

                    <input type="hidden" name="_token" value="{{ csrf_token('newsletter-subscribe') }}">
                    <input type="hidden" name="redirect" value="{{ app.request.uri }}">

                    <div class="site-footer__newsletter-icon">
                        <i class="fa-regular fa-envelope"></i>
                    </div>

                    <div class="site-footer__newsletter-content">

                        <p class="site-footer__newsletter-title">
                            Restez informé
                        </p>

                        <input
                            type="email"
                            name="email"
                            class="site-footer__newsletter-input"
                            placeholder="Ton adresse e-mail"
                            required
                        >

                    </div>

                    <button type="submit" class="site-footer__newsletter-arrow" aria-label="S'inscrire à la newsletter">
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>

                </form>

            </div>

        </div>

    </div>


    {# =========================================================
       BARRE INFÉRIEURE
       ========================================================= #}

    <div class="site-footer__bottom">

        <div class="site-footer__bottom-container">

            <p class="site-footer__copyright">
                © {{ "now"|date("Y") }} NTS Betting.
                Tous droits réservés.
            </p>


            <div class="site-footer__motto">

                <i class="fa-solid fa-crown site-footer__signature-crown"></i>
                
                <span class="site-footer__motto-text">
                    Pronostiquer
                    <span>•</span>
                    Analyser
                    <span>•</span>
                    Progresser
                </span>

            </div>


            <p class="site-footer__responsible">

                <span>18+</span>

                <span class="site-footer__separator">
                    |
                </span>

                <span>
                    Jouez de manière responsable.
                </span>

            </p>

        </div>

    </div>

</footer>