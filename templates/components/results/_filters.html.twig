{# =========================================================
   NTS BETTING — RESULTS — FILTRES
   ========================================================= #}

<section class="results-filters">

    <div class="results-filters__container">

        <div class="results-filters__panel">

            {# =================================================
               HEADER
               ================================================= #}

            <div class="results-filters__header">

                <h2 class="results-filters__title">
                    Filtrer les résultats
                </h2>

            </div>


            {# =================================================
               FILTRES
               ================================================= #}

            <form class="results-filters__form" action="{{ path('app_results') }}" method="get">

                {# SPORT #}

                <div class="results-filter">

                    <label for="results-sport">
                        Sport
                    </label>

                    <select id="results-sport" name="sport">

                        <option value="">
                            Tous
                        </option>

                        {% for sport in availableSports %}
                            <option value="{{ sport }}" {{ filters.sport == sport ? 'selected' : '' }}>
                                {{ sport|capitalize }}
                            </option>
                        {% endfor %}

                    </select>

                </div>


                {# COMPÉTITION #}

                <div class="results-filter">

                    <label for="results-competition">
                        Compétition
                    </label>

                    <select
                        id="results-competition"
                        name="competition"
                    >

                        <option value="">
                            Toutes
                        </option>

                        {% for competition in availableCompetitions %}
                            <option value="{{ competition }}" {{ filters.competition == competition ? 'selected' : '' }}>
                                {{ competition }}
                            </option>
                        {% endfor %}

                    </select>

                </div>


                {# TYPE DE PRONOSTIC #}

                <div class="results-filter">

                    <label for="results-type">
                        Type de pronostic
                    </label>

                    <select
                        id="results-type"
                        name="type"
                    >

                        <option value="">
                            Tous
                        </option>

                        {% for betType in availableBetTypes %}
                            <option value="{{ betType }}" {{ filters.type == betType ? 'selected' : '' }}>
                                {{ betType }}
                            </option>
                        {% endfor %}

                    </select>

                </div>


                {# PÉRIODE #}

                <div class="results-filter">

                    <label for="results-period">
                        Période
                    </label>

                    <select
                        id="results-period"
                        name="period"
                    >

                        <option value="7" {{ filters.period == 7 ? 'selected' : '' }}>
                            7 derniers jours
                        </option>

                        <option value="30" {{ filters.period == 30 ? 'selected' : '' }}>
                            30 derniers jours
                        </option>

                        <option value="90" {{ filters.period == 90 ? 'selected' : '' }}>
                            90 derniers jours
                        </option>

                        <option value="365" {{ filters.period == 365 ? 'selected' : '' }}>
                            Cette année
                        </option>

                    </select>

                </div>


                {# STATUT #}

                <div class="results-filter">

                    <label for="results-status">
                        Statut
                    </label>

                    <select
                        id="results-status"
                        name="status"
                    >

                        <option value="">
                            Tous
                        </option>

                        <option value="won" {{ filters.status == 'won' ? 'selected' : '' }}>
                            Gagné
                        </option>

                        <option value="lost" {{ filters.status == 'lost' ? 'selected' : '' }}>
                            Perdu
                        </option>

                    </select>

                </div>


                {# BOUTON #}

                <button
                    type="submit"
                    class="results-filters__button"
                >

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <span>
                        Filtrer
                    </span>

                </button>

            </form>

        </div>

    </div>

</section>
