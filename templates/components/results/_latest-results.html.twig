{# =========================================================
   NTS BETTING — RESULTS — DERNIERS RÉSULTATS
   ========================================================= #}

<section class="latest-results">

    <div class="latest-results__container">

        {# =====================================================
           HEADER
           ===================================================== #}

        <div class="latest-results__header">

            <div class="latest-results__heading">

                <span class="latest-results__eyebrow">
                    Performances
                </span>

                <h2 class="latest-results__title">
                    Derniers résultats
                    <span>({{ filters.period }} derniers jours)</span>
                </h2>

            </div>

        </div>


        {# =====================================================
           TABLEAU
           ===================================================== #}

        {% if latestResults is empty %}

            <p class="latest-results__empty">
                Aucun résultat pour cette période / ces filtres pour le moment.
            </p>

        {% else %}

            <div class="latest-results__table-wrapper">

                <table class="latest-results__table">

                    <thead>

                        <tr>

                            <th>Date</th>
                            <th>Sport</th>
                            <th>Compétition</th>
                            <th>Match</th>
                            <th>Pronostic</th>
                            <th>Cote</th>
                            <th>Mise (€)</th>
                            <th>Résultat</th>
                            <th>Gain / Perte</th>

                        </tr>

                    </thead>


                    <tbody>

                        {% for pronostic in latestResults %}

                            {% set won = pronostic.status == 'won' %}
                            {% set gain = statsService.profit(pronostic) %}

                            <tr>

                                <td>{{ pronostic.matchDate|date('d M. Y') }}</td>

                                <td>
                                    <span class="latest-results__sport">
                                        <i class="fa-solid {{ pronostic.sport == 'basketball' ? 'fa-basketball' : (pronostic.sport == 'tennis' ? 'fa-table-tennis-paddle-ball' : 'fa-futbol') }}"></i>
                                        {{ pronostic.sport|capitalize }}
                                    </span>
                                </td>

                                <td>{{ pronostic.competition }}</td>

                                <td class="latest-results__match">
                                    {{ pronostic.teamHome }} vs {{ pronostic.teamAway }}
                                </td>

                                <td>
                                    {{ pronostic.betType }} - {{ pronostic.betValue }}
                                </td>

                                <td class="latest-results__odds">
                                    {{ pronostic.odds|odds }}
                                </td>

                                <td>
                                    {{ '%.2f'|format(pronostic.stake) }}
                                </td>

                                <td>

                                    {% if won %}
                                        <span class="latest-results__status latest-results__status--won">
                                            <i class="fa-solid fa-check"></i>
                                            Gagné
                                        </span>
                                    {% else %}
                                        <span class="latest-results__status latest-results__status--lost">
                                            <i class="fa-solid fa-xmark"></i>
                                            Perdu
                                        </span>
                                    {% endif %}

                                </td>

                                <td class="latest-results__profit {{ gain >= 0 ? 'latest-results__profit--positive' : 'latest-results__profit--negative' }}">
                                    {{ gain > 0 ? '+' : '' }}{{ '%.2f'|format(gain) }} €
                                </td>

                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        {% endif %}

    </div>

</section>
