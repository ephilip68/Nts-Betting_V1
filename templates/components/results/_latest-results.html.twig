{# =========================================================
   NTS BETTING — RESULTS — DERNIERS RÉSULTATS
   ========================================================= #}

<section class="latest-results">

    <div class="latest-results__container">

        {# =====================================================
           HEADER
           ===================================================== #}

        <div class="latest-results__header">

            <div class="latest-results__heading">

                <span class="latest-results__eyebrow">
                    Performances
                </span>

                <h2 class="latest-results__title">
                    Derniers résultats
                    <span>(30 derniers jours)</span>
                </h2>

            </div>


            <a href="#" class="latest-results__history">

                <span>
                    Voir l'historique complet
                </span>

                <i class="fa-solid fa-arrow-right"></i>

            </a>

        </div>


        {# =====================================================
           TABLEAU
           ===================================================== #}

        <div class="latest-results__table-wrapper">

            <table class="latest-results__table">

                <thead>

                    <tr>

                        <th>Date</th>
                        <th>Sport</th>
                        <th>Compétition</th>
                        <th>Match</th>
                        <th>Pronostic</th>
                        <th>Cote</th>
                        <th>Mise (€)</th>
                        <th>Résultat</th>
                        <th>Gain / Perte</th>
                        <th></th>

                    </tr>

                </thead>


                <tbody>

                    {# =================================================
                       RÉSULTAT 1
                       Mise 2€ — Cote 1.65
                       Gain = 2 × (1.65 - 1) = +1.30€
                       ================================================= #}

                    {% set mise = 2 %}
                    {% set cote = 1.65 %}
                    {% set gagne = true %}
                    {% set gain = gagne ? (mise * (cote - 1)) : (-mise) %}

                    <tr>

                        <td>12 Nov. 2024</td>

                        <td>
                            <span class="latest-results__sport">
                                <i class="fa-solid fa-futbol"></i>
                                Football
                            </span>
                        </td>

                        <td>Ligue 1</td>

                        <td class="latest-results__match">
                            Real Madrid vs Braga
                        </td>

                        <td>
                            1X2 - Real Madrid
                        </td>

                        <td class="latest-results__odds">
                            {{ '%.2f'|format(cote) }}
                        </td>

                        <td>
                            {{ '%.0f'|format(mise) }} €
                        </td>

                        <td>

                            <span class="latest-results__status latest-results__status--won">
                                <i class="fa-solid fa-check"></i>
                                Gagné
                            </span>

                        </td>

                        <td class="latest-results__profit latest-results__profit--positive">
                            +{{ '%.2f'|format(gain) }} €
                        </td>

                        <td class="latest-results__arrow">
                            <i class="fa-solid fa-chevron-right"></i>
                        </td>

                    </tr>


