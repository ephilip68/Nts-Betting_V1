<section class="results-performance">

    <div class="results-performance__container">

        {# =====================================================
           ÉVOLUTION DES PERFORMANCES
           ===================================================== #}

        <article class="performance-card performance-card--chart">

            <div class="performance-card__header">

                <div>
                    <p class="performance-card__eyebrow">
                        Analyse
                    </p>

                    <h2 class="performance-card__title">
                        Évolution des performances
                    </h2>
                </div>

            </div>


            <div class="performance-card__legend">

                <span class="performance-legend performance-legend--units">
                    <i></i>
                    Gains (€)
                </span>

                <span class="performance-legend performance-legend--rate">
                    <i></i>
                    Taux de réussite
                </span>

            </div>


            {% if stats.settledCount == 0 %}

                <p class="latest-results__empty">
                    Pas encore assez de résultats pour afficher un graphique.
                </p>

            {% else %}

                <div class="performance-chart">

                    <div class="performance-chart__y-axis">
                        {% for label in chart.yAxisLabels %}
                            <span>{{ label }}</span>
                        {% endfor %}
                    </div>


                    <div class="performance-chart__area">

                        <div class="performance-chart__grid">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>


                        {# BARRES #}

                        <div class="performance-chart__bars">
                            {% for bar in chart.bars %}
                                <span style="height: {{ bar.heightPercent }}%;" title="{{ bar.label }} : {{ bar.unitsWon }} €"></span>
                            {% endfor %}
                        </div>


                        {# COURBE #}

                        <svg
                            class="performance-chart__line"
                            viewBox="0 0 500 150"
                            preserveAspectRatio="none"
                            aria-hidden="true"
                        >

                            <polyline points="{{ chart.polyline }}"/>

                            {% for circle in chart.circles %}
                                <circle cx="{{ circle.x }}" cy="{{ circle.y }}" r="2.5"/>
                            {% endfor %}

                        </svg>


                        <div class="performance-chart__months">
                            {% for month in monthlyPerformance %}
                                <span>{{ month.label }}</span>
                            {% endfor %}
                        </div>

                    </div>


                    <div class="performance-chart__right-axis">
                        <span>100%</span>
                        <span>75%</span>
                        <span>50%</span>
                        <span>25%</span>
                        <span>0%</span>
                    </div>

                </div>

            {% endif %}

        </article>


        {# =====================================================
           RÉPARTITION PAR SPORT
           ===================================================== #}

        <article class="performance-card performance-card--sports">

            <div class="performance-card__header">

                <div>

                    <p class="performance-card__eyebrow">
                        Répartition
                    </p>

                    <h2 class="performance-card__title">
                        Répartition par sport
                    </h2>

                </div>

            </div>


            {% if sportDistribution is empty %}

                <p class="latest-results__empty">
                    Pas encore de données par sport.
                </p>

            {% else %}

                {% set donutColors = ['var(--color-gold)', '#f59e0b', '#3b82f6', '#94a3b8', '#64748b'] %}
                {% set cumulative = 0 %}
                {% set stops = [] %}

                {% for sport in sportDistribution %}
                    {% set color = donutColors[loop.index0 % donutColors|length] %}
                    {% set stops = stops|merge(["#{color} #{cumulative}% #{cumulative + sport.percent}%"]) %}
                    {% set cumulative = cumulative + sport.percent %}
                {% endfor %}

                <div class="sports-distribution">

                    <div class="sports-donut" style="background: conic-gradient({{ stops|join(', ') }});">

                        <div class="sports-donut__center">

                            <strong>{{ stats.winRate }}%</strong>

                            <span>
                                de réussite
                            </span>

                        </div>

                    </div>


                    <div class="sports-list">

                        {% for sport in sportDistribution %}
                            <div class="sports-list__item">

                                <span class="sports-list__icon">
                                    <i class="fa-solid {{ sport.icon }}"></i>
                                </span>

                                <span class="sports-list__name">
                                    {{ sport.label }}
                                </span>

                                <strong>{{ sport.percent }}%</strong>

                            </div>
                        {% endfor %}

                    </div>

                </div>

            {% endif %}

        </article>


        {# =====================================================
           STATISTIQUES CLÉS
           ===================================================== #}

        <article class="performance-card performance-card--key-stats">

            <div class="performance-card__header">

                <div>

                    <p class="performance-card__eyebrow">
                        Performance
                    </p>

                    <h2 class="performance-card__title">
                        Statistiques clés
                    </h2>

                </div>

            </div>


            <div class="key-stats">

                <div class="key-stat">

                    <span class="key-stat__icon">
                        <i class="fa-solid fa-bullseye"></i>
                    </span>

                    <span class="key-stat__label">
                        Cote moyenne
                    </span>

                    <strong class="key-stat__value">
                        {{ stats.avgOdds ?? '—' }}
                    </strong>

                </div>


                <div class="key-stat">

                    <span class="key-stat__icon">
                        <i class="fa-solid fa-stopwatch"></i>
                    </span>

                    <span class="key-stat__label">
                        Mise moyenne
                    </span>

                    <strong class="key-stat__value">
                        {{ stats.avgStake is not null ? stats.avgStake ~ ' €' : '—' }}
                    </strong>

                </div>


                <div class="key-stat">

                    <span class="key-stat__icon">
                        <i class="fa-solid fa-chart-line"></i>
                    </span>

                    <span class="key-stat__label">
                        ROI
                    </span>

                    <strong class="key-stat__value {{ stats.roi is not null and stats.roi >= 0 ? 'key-stat__value--positive' : '' }}">
                        {{ stats.roi is not null ? (stats.roi > 0 ? '+' : '') ~ stats.roi ~ '%' : '—' }}
                    </strong>

                </div>


                <div class="key-stat">

                    <span class="key-stat__icon">
                        <i class="fa-solid fa-arrow-trend-up"></i>
                    </span>

                    <span class="key-stat__label">
                        Plus longue série gagnante
                    </span>

                    <strong class="key-stat__value">
                        {{ stats.longestWinStreak }}
                    </strong>

                </div>


                <div class="key-stat">

                    <span class="key-stat__icon">
                        <i class="fa-solid fa-arrow-trend-down"></i>
                    </span>

                    <span class="key-stat__label">
                        Plus longue série perdante
                    </span>

                    <strong class="key-stat__value">
                        {{ stats.longestLossStreak }}
                    </strong>

                </div>


                <div class="key-stat">

                    <span class="key-stat__icon">
                        <i class="fa-regular fa-calendar"></i>
                    </span>

                    <span class="key-stat__label">
                        Meilleur mois
                    </span>

                    <strong class="key-stat__value key-stat__value--month">
                        {% if stats.bestMonth %}
                            {{ stats.bestMonth.label }}
                            <small>(+{{ stats.bestMonth.units }} €)</small>
                        {% else %}
                            —
                        {% endif %}
                    </strong>

                </div>

            </div>

        </article>

    </div>

</section>
