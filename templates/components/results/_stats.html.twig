{# =========================================================
   NTS BETTING — RESULTS — STATISTIQUES
   ========================================================= #}

<section class="results-stats">

    <div class="results-stats__container">

        {# =====================================================
           TAUX DE RÉUSSITE
           ===================================================== #}

        <div class="results-stat-card">

            <div class="results-stat-card__icon">
                <i class="fa-solid fa-bullseye"></i>
            </div>

            <div class="results-stat-card__content">

                <strong class="results-stat-card__value">
                    {{ stats.winRate is not null ? stats.winRate ~ '%' : '—' }}
                </strong>

                <span class="results-stat-card__label">
                    Taux de réussite global
                </span>

            </div>

        </div>


        {# =====================================================
           PRONOSTICS PUBLIÉS
           ===================================================== #}

        <div class="results-stat-card">

            <div class="results-stat-card__icon">
                <i class="fa-solid fa-chart-column"></i>
            </div>

            <div class="results-stat-card__content">

                <strong class="results-stat-card__value">
                    {{ stats.settledCount }}
                </strong>

                <span class="results-stat-card__label">
                    Pronostics joués
                </span>

            </div>

        </div>


        {# =====================================================
           UNITÉS GAGNÉES
           ===================================================== #}

        <div class="results-stat-card {{ stats.unitsProfit >= 0 ? 'results-stat-card--success' : '' }}">

            <div class="results-stat-card__icon">
                <i class="fa-solid fa-arrow-trend-up"></i>
            </div>

            <div class="results-stat-card__content">

                <strong class="results-stat-card__value">
                    {{ stats.unitsProfit > 0 ? '+' : '' }}{{ stats.unitsProfit }} €
                </strong>

                <span class="results-stat-card__label">
                    Gains cumulés
                </span>

            </div>

        </div>


        {# =====================================================
           ROI
           ===================================================== #}

        <div class="results-stat-card">

            <div class="results-stat-card__icon">
                <i class="fa-solid fa-coins"></i>
            </div>

            <div class="results-stat-card__content">

                <strong class="results-stat-card__value">
                    {{ stats.roi is not null ? (stats.roi > 0 ? '+' : '') ~ stats.roi ~ '%' : '—' }}
                </strong>

                <span class="results-stat-card__label">
                    ROI*
                </span>

            </div>

        </div>


        {# =====================================================
           MEMBRES ACTIFS
           ===================================================== #}

        <div class="results-stat-card">

            <div class="results-stat-card__icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <div class="results-stat-card__content">

                <strong class="results-stat-card__value">
                    {{ activeMembersCount }}
                </strong>

                <span class="results-stat-card__label">
                    Membres actifs
                </span>

            </div>

        </div>

    </div>

    <p class="results-stats__disclaimer">
        * Gains et ROI calculés sur une mise nominale par pronostic, à titre indicatif — performances passées non contractuelles.
    </p>

</section>
