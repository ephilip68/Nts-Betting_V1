{# =========================================================
   NTS BETTING — RESULTS — DERNIERS TICKETS
   ========================================================= #}

<section class="latest-tickets">

    <div class="latest-tickets__container">

        {# =====================================================
           HEADER
           ===================================================== #}

        <div class="latest-tickets__header">

            <div class="latest-tickets__heading">

                <span class="latest-tickets__eyebrow">
                    Historique récent
                </span>

                <h2 class="latest-tickets__title">
                    Derniers tickets
                </h2>

                <p class="latest-tickets__subtitle">
                    Retrouvez les derniers pronostics publiés et leurs résultats.
                </p>

            </div>

        </div>


        {# =====================================================
           TICKETS
           ===================================================== #}

        {% if recentTickets is empty %}

            <p class="latest-results__empty">
                Aucun ticket joué pour le moment.
            </p>

        {% else %}

            {% set sportBg = {
                'football': '/images/resultats/football/staduim.png',
                'basketball': '/images/resultats/basketball/basketball.png',
                'tennis': '/images/resultats/tennis/atp.png',
            } %}

            {% set sportIcon = {
                'football': 'fa-futbol',
                'basketball': 'fa-basketball',
                'tennis': 'fa-table-tennis-paddle-ball',
            } %}

            <div class="latest-tickets__grid">

                {% for pronostic in recentTickets %}

                    {% set won = pronostic.status == 'won' %}
                    {% set gain = statsService.profit(pronostic) %}

                    <article class="latest-ticket {{ won ? 'latest-ticket--won' : 'latest-ticket--lost' }}">

                        <div class="latest-ticket__top">

                            <div class="latest-ticket__sport">

                                <span class="latest-ticket__sport-icon">
                                    <i class="fa-solid {{ sportIcon[pronostic.sport] ?? 'fa-circle' }}"></i>
                                </span>

                                <div>
                                    <strong>{{ pronostic.sport|capitalize }}</strong>

                                    <small>
                                        {{ pronostic.competition }}
                                    </small>
                                </div>

                            </div>


                            <span class="latest-ticket__status {{ won ? 'latest-ticket__status--won' : 'latest-ticket__status--lost' }}">
                                <i class="fa-solid {{ won ? 'fa-check' : 'fa-xmark' }}"></i>
                                {{ won ? 'Gagné' : 'Perdu' }}
                            </span>

                        </div>


                        {# MATCH #}

                        <div class="latest-ticket__match latest-ticket__match--{{ pronostic.sport }}">

                            {% if sportBg[pronostic.sport] is defined %}
                                <img
                                    class="latest-ticket__match-bg"
                                    src="{{ sportBg[pronostic.sport] }}"
                                    alt=""
                                    aria-hidden="true"
                                >
                            {% endif %}

                            <div class="latest-ticket__match-overlay"></div>


                            <div class="latest-ticket__team">

                                {% if pronostic.teamHomeLogo %}
                                    <img src="{{ pronostic.teamHomeLogo }}" alt="{{ pronostic.teamHome }}">
                                {% endif %}

                                <strong>
                                    {{ pronostic.teamHome }}
                                </strong>

                            </div>


                            <span class="latest-ticket__vs">
                                VS
                            </span>


                            <div class="latest-ticket__team">

                                {% if pronostic.teamAwayLogo %}
                                    <img src="{{ pronostic.teamAwayLogo }}" alt="{{ pronostic.teamAway }}">
                                {% endif %}

                                <strong>
                                    {{ pronostic.teamAway }}
                                </strong>

                            </div>

                        </div>


                        {# PRONOSTIC #}

                        <div class="latest-ticket__prediction">

                            <span>
                                Pronostic
                            </span>

                            <strong>
                                {{ pronostic.betValue }}
                            </strong>

                        </div>


                        {# STATS #}

                        <div class="latest-ticket__stats">

                            <div class="latest-ticket__stat">

                                <span>
                                    Cote
                                </span>

                                <strong>
                                    {{ pronostic.odds|odds }}
                                </strong>

                            </div>


                            <div class="latest-ticket__stat">

                                <span>
                                    Mise
                                </span>

                                <strong>
                                    {{ '%.2f'|format(pronostic.stake) }} €
                                </strong>

                            </div>


                            <div class="latest-ticket__stat">

                                <span>
                                    Résultat
                                </span>

                                <strong class="{{ won ? 'latest-ticket__profit' : 'latest-ticket__loss' }}">
                                    {{ gain > 0 ? '+' : '' }}{{ '%.2f'|format(gain) }} €
                                </strong>

                            </div>

                        </div>


                        {# FOOTER #}

                        <div class="latest-ticket__footer">

                            <span>
                                <i class="fa-regular fa-calendar"></i>
                                {{ pronostic.matchDate|date('d M. Y') }}
                            </span>

                            <span>
                                <i class="fa-solid fa-tag"></i>
                                NTS Betting
                            </span>

                        </div>

                    </article>

                {% endfor %}

            </div>

        {% endif %}

    </div>

</section>
