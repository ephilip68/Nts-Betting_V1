{# =========================================================
   COMMUNITY — FILTERS
   ========================================================= #}
<section class="community-filters">

    <div class="community-filters__container">

        {# =====================================================
           TITRE
           ===================================================== #}

        <div class="community-filters__heading">

            <h1 class="community-filters__title">
                <span>COMMUNAUTÉ</span>
                <strong>NTS</strong>
            </h1>

            <p class="community-filters__subtitle">
                Partagez vos tickets, échangez vos analyses et progressez ensemble.
            </p>

        </div>


        {# =====================================================
           RECHERCHE
           ===================================================== #}

        <form class="community-filters__search" method="get" action="{{ path('app_community') }}">

            {% if currentType %}<input type="hidden" name="type" value="{{ currentType }}">{% endif %}
            {% if currentSport %}<input type="hidden" name="sport" value="{{ currentSport }}">{% endif %}

            <div class="community-filters__search-field">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input
                    type="search"
                    name="q"
                    value="{{ currentSearch }}"
                    placeholder="Rechercher un membre, un message..."
                    aria-label="Rechercher dans la communauté"
                >

            </div>

            <button
                type="submit"
                class="community-filters__search-button"
            >
                <i class="fa-solid fa-magnifying-glass"></i>
                <span>Rechercher</span>
            </button>

        </form>


        {# =====================================================
           FEATURES
           ===================================================== #}

        <div class="community-filters__features">

            <div class="community-filters__feature">

                <div class="community-filters__feature-icon">
                    <i class="fa-solid fa-users"></i>
                </div>

                <span>Échangez</span>

            </div>


            <div class="community-filters__feature">

                <div class="community-filters__feature-icon">
                    <i class="fa-solid fa-rocket"></i>
                </div>

                <span>Progressez</span>

            </div>


            <div class="community-filters__feature">

                <div class="community-filters__feature-icon">
                    <i class="fa-solid fa-crown"></i>
                </div>

                <span>Vivez le pari ensemble</span>

            </div>

        </div>

    </div>

</section>