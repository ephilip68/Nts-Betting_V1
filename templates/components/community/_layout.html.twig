{# =========================================================
   NTS BETTING — COMMUNITY MAIN LAYOUT
   ========================================================= #}

<section class="community-layout">

    <div class="community-layout__container">


        {# =====================================================
           SIDEBAR GAUCHE
           ===================================================== #}

        <aside class="community-sidebar community-sidebar--left">

            {# ===============================
               PUBLIER
               =============================== #}

            <button
                type="button"
                class="community-sidebar__publish"
                data-community-open-composer
            >
                <i class="fa-solid fa-plus"></i>
                <span>Publier</span>
            </button>


            {# ===============================
               NAVIGATION
               =============================== #}

            <nav class="community-sidebar__nav">

                <a href="{{ path('app_community', {sport: currentSport, q: currentSearch, sort: currentSort}) }}" class="community-sidebar__nav-item {{ not currentType ? 'is-active' : '' }}">
                    <i class="fa-solid fa-house"></i>
                    <span>Tous</span>
                </a>

                <a href="{{ path('app_community', {type: 'ticket', sport: currentSport, q: currentSearch, sort: currentSort}) }}" class="community-sidebar__nav-item {{ currentType == 'ticket' ? 'is-active' : '' }}">
                    <i class="fa-regular fa-image"></i>
                    <span>Tickets</span>
                </a>

                <a href="{{ path('app_community', {type: 'discussion', sport: currentSport, q: currentSearch, sort: currentSort}) }}" class="community-sidebar__nav-item {{ currentType == 'discussion' ? 'is-active' : '' }}">
                    <i class="fa-regular fa-comment"></i>
                    <span>Discussions</span>
                </a>

                <a href="{{ path('app_community', {type: 'analyse', sport: currentSport, q: currentSearch, sort: currentSort}) }}" class="community-sidebar__nav-item {{ currentType == 'analyse' ? 'is-active' : '' }}">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Analyses</span>
                </a>

                <a href="{{ path('app_community', {type: 'vip', sport: currentSport, q: currentSearch, sort: currentSort}) }}" class="community-sidebar__nav-item {{ currentType == 'vip' ? 'is-active' : '' }}">
                    <i class="fa-solid fa-crown"></i>
                    <span>VIP</span>
                </a>

            </nav>


            {# ===============================
               SPORTS
               =============================== #}

            <div class="community-sidebar__section">

                <div class="community-sidebar__section-heading">

                    <h3 class="community-sidebar__section-title">
                        Sports
                    </h3>

                </div>


                <div class="community-sidebar__sports">

                    {% set sportsList = {
                        football: {label: 'Football', icon: 'fa-futbol'},
                        tennis: {label: 'Tennis', icon: 'fa-table-tennis-paddle-ball'},
                        basketball: {label: 'Basketball', icon: 'fa-basketball'},
                        'sports-us': {label: 'Sports US', icon: 'fa-football'},
                        other: {label: 'Autres', icon: 'fa-ellipsis'},
                    } %}

                    {% for slug, sportInfo in sportsList %}
                        <a
                            href="{{ path('app_community', {type: currentType, sport: currentSport == slug ? null : slug, q: currentSearch, sort: currentSort}) }}"
                            class="community-sidebar__sport {{ currentSport == slug ? 'is-active' : '' }}"
                        >

                            <span class="community-sidebar__sport-icon">
                                <i class="fa-solid {{ sportInfo.icon }}"></i>
                            </span>

                            <span class="community-sidebar__sport-name">
                                {{ sportInfo.label }}
                            </span>

                            <small>
                                {{ postsBySport[slug] ?? 0 }}
                            </small>

                        </a>
                    {% endfor %}

                </div>

            </div>


            {# ===============================
               MEMBRES EN LIGNE
               =============================== #}

            <div class="community-sidebar__section community-sidebar__section--members">

                <div class="community-sidebar__section-heading">

                    <h3 class="community-sidebar__section-title">
                        Membres abonnés
                    </h3>

                    <span class="community-sidebar__online-count">
                        {{ activeMembersCount }}
                    </span>

                </div>

                <p style="color:rgba(255,255,255,0.45); font-size:0.78rem; margin:0;">
                    Membres avec un abonnement actif sur NTS Betting.
                </p>

            </div>

        </aside>


        {# =====================================================
           FIL CENTRAL
           ===================================================== #}

        <main class="community-feed">
            {# =========================================================
                COMPOSER — NOUVELLE PUBLICATION
                ========================================================= #}

            <section class="community-composer">

                {% if app.user %}
                <form action="{{ path('app_community_post_create') }}" method="post" enctype="multipart/form-data" data-community-composer-form>

                <div class="community-composer__header">

                    <div class="community-composer__author">

                        <div class="community-composer__avatar">
                            {{ app.user.nickname|slice(0, 1)|upper }}
                        </div>

                        <div class="community-composer__author-info">
                            <strong>Partager avec la communauté</strong>

                            <span>
                                Partagez votre ticket, votre analyse ou lancez une discussion.
                            </span>
                        </div>

                    </div>

                    <button
                        type="button"
                        class="community-composer__close"
                        aria-label="Fermer"
                    >
                        <i class="fa-solid fa-xmark"></i>
                    </button>

                </div>


                <div class="community-composer__content">

                    <input type="hidden" name="type" value="TICKET" data-community-type-input>

                    <div class="community-composer__types">

                        <button
                            type="button"
                            class="community-composer__type is-active"
                            data-type="TICKET"
                        >
                            <i class="fa-regular fa-image"></i>
                            <span>Ticket</span>
                        </button>

                        <button
                            type="button"
                            class="community-composer__type"
                            data-type="DISCUSSION"
                        >
                            <i class="fa-regular fa-comment"></i>
                            <span>Discussion</span>
                        </button>

                        <button
                            type="button"
                            class="community-composer__type"
                            data-type="ANALYSE"
                        >
                            <i class="fa-solid fa-chart-line"></i>
                            <span>Analyse</span>
                        </button>

                        <button
                            type="button"
                            class="community-composer__type community-composer__type--vip"
                            data-type="VIP"
                        >
                            <i class="fa-solid fa-crown"></i>
                            <span>VIP</span>
                        </button>

                    </div>

                    <div class="community-composer__field">

                        <label for="community-sport">
                            Sport
                        </label>

                        <select
                            id="community-sport"
                            name="sport"
                            class="community-composer__select"
                        >
                            <option value="football">Football</option>
                            <option value="tennis">Tennis</option>
                            <option value="basketball">Basketball</option>
                            <option value="sports-us">Sports US</option>
                            <option value="other">Autres</option>
                        </select>

                    </div>

                    <div class="community-composer__analysis-fields" data-community-fields="ANALYSE" hidden>

                        <div class="community-composer__field">

                            <label for="community-analysis-title">
                                Titre de l'analyse
                            </label>

                            <input
                                type="text"
                                id="community-analysis-title"
                                name="analysisTitle"
                                class="community-composer__input"
                                placeholder="Ex : Real Madrid - AC Milan"
                            >

                        </div>

                    </div>

                    <div class="community-composer__vip-fields" data-community-fields="VIP" hidden>

                        <div class="community-composer__vip-notice">
                            <div class="community-composer__vip-notice-icon">
                                <i class="fa-solid fa-crown"></i>
                            </div>

                            <div class="community-composer__vip-notice-content">
                                <strong>Publication VIP</strong>
                                <span>
                                    Créez un pronostic premium réservé aux membres VIP.
                                </span>
                            </div>

                            <span class="community-composer__vip-badge">VIP</span>
                        </div>

                        <div class="community-composer__vip-grid">

                            <div class="community-composer__field">
                                <label for="community-vip-match">Match / Événement</label>
                                <input
                                    type="text"
                                    id="community-vip-match"
                                    name="vipMatch"
                                    class="community-composer__input"
                                    placeholder="Ex : Real Madrid — AC Milan"
                                >
                            </div>

                            <div class="community-composer__field">
                                <label for="community-vip-prediction">Pronostic</label>
                                <input
                                    type="text"
                                    id="community-vip-prediction"
                                    name="vipPrediction"
                                    class="community-composer__input"
                                    placeholder="Ex : Real Madrid gagne"
                                >
                            </div>

                            <div class="community-composer__field">
                                <label for="community-vip-odds">Cote</label>
                                <input
                                    type="number"
                                    id="community-vip-odds"
                                    name="vipOdds"
                                    class="community-composer__input"
                                    placeholder="Ex : 1.85"
                                    step="0.01"
                                    min="1"
                                >
                            </div>

                            <div class="community-composer__field">
                                <label for="community-vip-stake">Mise conseillée</label>
                                <input
                                    type="text"
                                    id="community-vip-stake"
                                    name="vipStake"
                                    class="community-composer__input"
                                    placeholder="Ex : 2% bankroll"
                                >
                            </div>

                            <div class="community-composer__field">
                                <label for="community-vip-confidence">Confiance</label>
                                <select
                                    id="community-vip-confidence"
                                    name="vipConfidence"
                                    class="community-composer__select"
                                >
                                    <option value="">Sélectionner</option>
                                    <option value="1">★☆☆☆☆</option>
                                    <option value="2">★★☆☆☆</option>
                                    <option value="3">★★★☆☆</option>
                                    <option value="4">★★★★☆</option>
                                    <option value="5">★★★★★</option>
                                </select>
                            </div>

                        </div>

                        <div class="community-composer__vip-lock">
                            <i class="fa-solid fa-lock"></i>

                            <div>
                                <strong>Pronostic premium</strong>
                                <span>
                                    Ces informations pourront être masquées pour les membres non VIP.
                                </span>
                            </div>
                        </div>

                    </div>

                    <textarea
                        name="content"
                        class="community-composer__textarea"
                        placeholder="Que souhaitez-vous partager avec la communauté ?"
                        rows="3"
                    ></textarea>

                    <div class="community-composer__upload">

                        <input
                            type="file"
                            id="community-photo-input"
                            name="photo"
                            class="community-composer__file"
                            accept="image/jpeg,image/png,image/webp"
                            data-community-photo-input
                            hidden
                        >

                        <div class="community-composer__upload-icon">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                        </div>

                        <div class="community-composer__upload-text">

                            <strong>
                                Ajoutez votre ticket ou une image
                            </strong>

                            <span>
                                Glissez-déposez votre fichier ici ou cliquez pour parcourir
                            </span>

                        </div>

                        <label for="community-photo-input" class="community-composer__upload-button">
                            Parcourir
                        </label>

                    </div>


                    <div class="community-composer__preview" data-community-preview hidden>

                        <div class="community-composer__preview-image">
                            <img src="" alt="Aperçu du ticket" data-community-preview-image>
                        </div>

                        <div class="community-composer__preview-info">
                            <strong class="community-composer__preview-name" data-community-preview-name></strong>
                            <span>Image sélectionnée</span>
                        </div>

                        <button
                            type="button"
                            class="community-composer__preview-remove"
                            aria-label="Supprimer l'image"
                            data-community-preview-remove
                        >
                            <i class="fa-solid fa-xmark"></i>
                        </button>

                    </div>


                    <div class="community-composer__footer">

                        <div class="community-composer__info">

                            <i class="fa-solid fa-circle-info"></i>

                            <span>
                                Formats acceptés : JPG, PNG, WEBP
                            </span>

                        </div>

                        <button
                            type="submit"
                            class="community-composer__publish"
                        >
                            <span>Publier</span>

                            <i class="fa-solid fa-paper-plane"></i>
                        </button>

                    </div>

                </div>

                </form>
                {% else %}
                <p style="padding:20px; color:rgba(255,255,255,0.5);">
                    <a href="{{ path('app_login') }}">Connecte-toi</a> pour publier dans la communauté.
                </p>
                {% endif %}

            </section>

            {% for post in posts %}

                <article class="community-post community-post--{{ post.type|lower }}" data-post-id="{{ post.id }}" id="post-{{ post.id }}">

                    <header class="community-post__header">

                        <div class="community-post__author">

                            <div class="community-post__avatar">
                                {{ post.user.nickname|first|upper }}
                            </div>

                            <div class="community-post__author-info">

                                <strong>
                                    {{ post.user.nickname }}

                                    {% if post.user.isVip %}
                                        <i class="fa-solid fa-crown"></i>
                                    {% endif %}
                                </strong>

                                <span>
                                    {{ post.createdAt|date('d/m/Y H:i') }}
                                    ·
                                    {{ post.sport|capitalize }}
                                </span>

                            </div>

                        </div>

                        {% if app.user and (app.user == post.user or is_granted('ROLE_ADMIN')) %}
                            <form action="{{ path('app_community_post_delete', {id: post.id}) }}" method="post" onsubmit="return confirm('Supprimer cette publication ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-community-post-' ~ post.id) }}">
                                <button type="submit" class="community-post__menu" aria-label="Supprimer">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        {% endif %}

                    </header>


                    <div class="community-post__body">

                        <div class="community-post__tags">

                            <span class="community-post__tag community-post__tag--{% if post.type == 'ANALYSE' %}analysis{% elseif post.type == 'DISCUSSION' %}discussion{% elseif post.type == 'TICKET' %}ticket{% elseif post.type == 'VIP' %}vip{% endif %}">
                                {{ post.type|capitalize }}
                            </span>

                        </div>

                        {% if post.type == 'ANALYSE' and post.analysisTitle %}

                            <div class="community-post__analysis-info">

                                <strong>
                                    {{ post.analysisTitle }}
                                </strong>

                                <span>
                                    {{ post.sport|capitalize }}
                                </span>

                            </div>

                        {% endif %}


                        {% if post.type == 'VIP' %}

                            <div class="community-post__vip-info">

                                <div class="community-post__vip-header">

                                    <i class="fa-solid fa-crown"></i>

                                    <strong>
                                        Pronostic VIP
                                    </strong>

                                    <span>
                                        VIP
                                    </span>

                                </div>

                                <div class="community-post__vip-match">
                                    {{ post.vipMatch }}
                                </div>

                                {% if app.user and app.user.isVip %}

                                    <div class="community-post__vip-grid">

                                        <div>
                                            <span>Pronostic</span>
                                            <strong>{{ post.vipPrediction ?: '—' }}</strong>
                                        </div>

                                        <div>
                                            <span>Cote</span>
                                            <strong>{{ post.vipOdds ?: '—' }}</strong>
                                        </div>

                                        <div>
                                            <span>Mise conseillée</span>
                                            <strong>{{ post.vipStake ?: '—' }}</strong>
                                        </div>

                                        <div>
                                            <span>Confiance</span>

                                            <strong>
                                                {% if post.vipConfidence == 1 %}
                                                    ★☆☆☆☆
                                                {% elseif post.vipConfidence == 2 %}
                                                    ★★☆☆☆
                                                {% elseif post.vipConfidence == 3 %}
                                                    ★★★☆☆
                                                {% elseif post.vipConfidence == 4 %}
                                                    ★★★★☆
                                                {% elseif post.vipConfidence == 5 %}
                                                    ★★★★★
                                                {% else %}
                                                    —
                                                {% endif %}
                                            </strong>
                                        </div>

                                    </div>

                                {% else %}

                                    <div class="community-post__vip-lock">

                                        <i class="fa-solid fa-lock"></i>

                                        <span>
                                            Pronostic, cote et mise réservés aux membres VIP.
                                            <a href="{{ path('app_offers') }}" style="color:var(--color-gold, #DDB219);">Découvrir le VIP</a>
                                        </span>

                                    </div>

                                {% endif %}

                            </div>

                        {% endif %}

                        <p class="community-post__text">
                            {{ post.content|nl2br }}
                        </p>


                        {% if post.photo %}
                            <div
                                class="community-post__media"
                                style="--ticket-background: url('{{ asset('uploads/community/' ~ post.photo) }}');"
                            >
                                <img
                                    src="{{ asset('uploads/community/' ~ post.photo) }}"
                                    alt="Publication de {{ post.user.nickname }}"
                                >
                            </div>
                        {% endif %}


                        <footer class="community-post__actions">

                            {% set userLiked = false %}
                            {% for like in post.communityLikes %}
                                {% if app.user and like.user.id == app.user.id %}
                                    {% set userLiked = true %}
                                {% endif %}
                            {% endfor %}

                            <button
                                type="button"
                                class="{{ userLiked ? 'is-liked' : '' }}"
                                data-community-like-button
                                data-post-id="{{ post.id }}"
                                data-like-token="{{ csrf_token('community-like-' ~ post.id) }}"
                                {{ app.user ? '' : 'disabled' }}
                            >
                                <i class="{{ userLiked ? 'fa-solid' : 'fa-regular' }} fa-heart" data-community-like-icon></i>
                                <span data-community-like-count>{{ post.communityLikes|length }}</span>
                            </button>

                            <button type="button" data-community-comment-toggle="comments-{{ post.id }}">
                                <i class="fa-regular fa-comment"></i>
                                <span>{{ post.communityComments|length }}</span>
                            </button>

                            <button
                                type="button"
                                class="community-post__share-button"
                                data-community-share
                                data-share-url="{{ url('app_community') }}#post-{{ post.id }}"
                            >
                                <i class="fa-solid fa-share-nodes"></i>
                                <span>Partager</span>
                            </button>

                        </footer>

                        {# =====================================================
                        COMMENTAIRES
                        ===================================================== #}

                        <div class="community-post__comments" id="comments-{{ post.id }}">

                            {% if app.user %}
                            <div class="community-post__comment-form" data-community-comment-form data-post-id="{{ post.id }}" data-comment-token="{{ csrf_token('community-comment-' ~ post.id) }}">

                                <div class="community-post__comment-avatar">
                                    {{ app.user.nickname|first|upper }}
                                </div>

                                <input
                                    type="text"
                                    class="community-post__comment-input"
                                    placeholder="Écrire un commentaire..."
                                    data-community-comment-input
                                >

                                <button
                                    type="button"
                                    class="community-post__comment-submit"
                                    aria-label="Publier le commentaire"
                                    data-community-comment-submit
                                >
                                    <i class="fa-solid fa-paper-plane"></i>
                                </button>

                            </div>
                            {% endif %}


                            <div class="community-post__comments-list" data-community-comments-list>

                               {% for comment in post.communityComments %}

                                    <div
                                        class="community-post__comment"
                                        data-comment-id="{{ comment.id }}"
                                    >

                                        {# Avatar #}
                                        <div class="community-post__comment-avatar">

                                            {% if comment.user.photo %}
                                                <img
                                                    src="{{ asset('uploads/profile/' ~ comment.user.photo) }}"
                                                    alt="{{ comment.user.nickname }}"
                                                >
                                            {% else %}
                                                {{ comment.user.nickname|first|upper }}
                                            {% endif %}

                                        </div>


                                        {# Contenu #}
                                        <div class="community-post__comment-content">

                                            <div class="community-post__comment-header">

                                                <strong>
                                                    {{ comment.user.nickname }}
                                                </strong>

                                                <span>
                                                    {{ comment.createdAt|date('d/m/Y H:i') }}
                                                </span>

                                            </div>

                                            <p>
                                                {{ comment.content }}
                                            </p>

                                        </div>

                                    </div>

                                {% else %}

                                    <div class="community-post__comments-empty">
                                        Aucun commentaire pour le moment.
                                    </div>

                                {% endfor %}

                            </div>

                        </div>

                    </div>

                </article>

            {% endfor %}

        </main>


        {# =====================================================
           SIDEBAR DROITE
           ===================================================== #}

        <aside class="community-sidebar community-sidebar--right">


            {# ===============================
               TOP CONTRIBUTEURS
               =============================== #}

            <section class="community-widget">

                <div class="community-widget__header">

                    <h3>
                        Top contributeurs
                    </h3>

                </div>


                <div class="community-widget__tabs">

                    <a href="{{ path('app_community', {type: currentType, sport: currentSport, q: currentSearch, sort: currentSort, period: 'week'}) }}" class="{{ currentPeriod == 'week' ? 'is-active' : '' }}">
                        Semaine
                    </a>

                    <a href="{{ path('app_community', {type: currentType, sport: currentSport, q: currentSearch, sort: currentSort, period: 'month'}) }}" class="{{ currentPeriod == 'month' ? 'is-active' : '' }}">
                        Mois
                    </a>

                    <a href="{{ path('app_community', {type: currentType, sport: currentSport, q: currentSearch, sort: currentSort, period: 'all'}) }}" class="{{ currentPeriod == 'all' ? 'is-active' : '' }}">
                        Tous
                    </a>

                </div>


                <div class="community-ranking">

                    {% for contributor in topContributors %}
                        <div class="community-ranking__item">

                            <span class="community-ranking__position">
                                {{ loop.index }}
                            </span>

                            <span class="community-ranking__avatar">
                                {{ contributor.user.nickname|slice(0, 1)|upper }}
                            </span>

                            <span class="community-ranking__name">
                                {{ contributor.user.nickname }}
                            </span>

                            <strong>
                                {{ contributor.score }} pts
                            </strong>

                        </div>
                    {% else %}
                        <p style="color:rgba(255,255,255,0.45); font-size:0.82rem;">Pas encore de contributions.</p>
                    {% endfor %}

                </div>

            </section>


            {# ===============================
               BLOC VIP
               =============================== #}

            <section class="community-vip">

                <div class="community-vip__icon">
                    <i class="fa-solid fa-crown"></i>
                </div>

                <h3 class="community-vip__title">
                    Passez au VIP
                </h3>

                <p class="community-vip__subtitle">
                    Accédez à une expérience exclusive
                </p>


                <ul class="community-vip__features">

                    <li>
                        <i class="fa-solid fa-check"></i>
                        <span>Accès aux publications VIP</span>
                    </li>

                    <li>
                        <i class="fa-solid fa-check"></i>
                        <span>Analyses exclusives</span>
                    </li>

                    <li>
                        <i class="fa-solid fa-check"></i>
                        <span>Échange avec les experts</span>
                    </li>

                    <li>
                        <i class="fa-solid fa-check"></i>
                        <span>Échange avec les meilleurs</span>
                    </li>

                    <li>
                        <i class="fa-solid fa-check"></i>
                        <span>Suivi privé</span>
                    </li>

                </ul>


                <a
                    href="{{ path('app_offers') }}"
                    class="community-vip__button"
                >
                    <span>Découvrir le VIP</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

            </section>


            {# ===============================
               CITATION
               =============================== #}

            <section class="community-quote">

                <i class="fa-solid fa-quote-left"></i>

                <p>
                    Seul on va plus vite,
                    ensemble on va plus loin.
                </p>

                <span>
                    NTS BETTING
                </span>

            </section>

        </aside>

    </div>

</section>