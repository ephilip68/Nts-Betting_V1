                    </li>

                </ul>


                <a
                    href="#"
                    class="community-vip__button"
                >
                    <span>Découvrir le VIP</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

            </section>


            {# ===============================
               CITATION
               =============================== #}

            <section class="community-quote">

                <i class="fa-solid fa-quote-left"></i>

                <p>
                    Seul on va plus vite,
                    ensemble on va plus loin.
                </p>

                <span>
                    NTS BETTING
                </span>

            </section>

        </aside>

    </div>

</section>