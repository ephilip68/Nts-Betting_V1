                        <small>
                            En ligne
                        </small>

                    </button>


                    <button type="button" class="community-sidebar__sport">

                        <span class="community-sidebar__sport-icon">
                            <i class="fa-solid fa-ellipsis"></i>
                        </span>

                        <span class="community-sidebar__sport-name">
                            Autres
                        </span>

                        <small>
                            En ligne
                        </small>

                    </button>

                </div>

            </div>


            {# ===============================
               MEMBRES EN LIGNE
               =============================== #}

            <div class="community-sidebar__section community-sidebar__section--members">

                <div class="community-sidebar__section-heading">

                    <h3 class="community-sidebar__section-title">
                        Membres en ligne
                    </h3>

                    <span class="community-sidebar__online-count">
                        5
                    </span>

                </div>


                <div class="community-sidebar__members">

                    <div class="community-sidebar__member">

                        <span class="community-sidebar__avatar">
                            T
                        </span>

                        <span class="community-sidebar__member-name">
                            Thomas11
                        </span>

                        <i class="community-sidebar__online"></i>

                    </div>


                    <div class="community-sidebar__member">

                        <span class="community-sidebar__avatar">
                            L
                        </span>

                        <span class="community-sidebar__member-name">
                            LéaPari
                        </span>

                        <i class="community-sidebar__online"></i>

                    </div>


                    <div class="community-sidebar__member">

                        <span class="community-sidebar__avatar">
                            M
