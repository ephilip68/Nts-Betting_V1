{# =========================================================
   NTS BETTING — COMMUNITY MAIN LAYOUT
   ========================================================= #}

<section class="community-layout">

    <div class="community-layout__container">


        {# =====================================================
           SIDEBAR GAUCHE
           ===================================================== #}

        <aside class="community-sidebar community-sidebar--left">

            {# ===============================
               PUBLIER
               =============================== #}

            <button
                type="button"
                class="community-sidebar__publish"
                data-community-open-composer
            >
                <i class="fa-solid fa-plus"></i>
                <span>Publier</span>
            </button>


            {# ===============================
               NAVIGATION
               =============================== #}

            <nav class="community-sidebar__nav">

                <button
                    type="button"
                    class="community-sidebar__nav-item is-active"
                >
                    <i class="fa-solid fa-house"></i>
                    <span>Tous</span>
                </button>

                <button
                    type="button"
                    class="community-sidebar__nav-item"
                >
                    <i class="fa-regular fa-image"></i>
                    <span>Tickets</span>
                </button>

                <button
                    type="button"
                    class="community-sidebar__nav-item"
                >
                    <i class="fa-regular fa-comment"></i>
