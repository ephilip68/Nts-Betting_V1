<header class="site-header">
    <div class="navbar-container">

        {# =====================================================
           LOGO
           ===================================================== #}

        <a href="{{ path('app_home') }}"
            class="navbar-logo"
            aria-label="NTS Betting - Accueil">

            <img
                src="{{ asset('images/logo/logo.png') }}"
                alt="NTS Betting"
                class="navbar-logo-image"
            >

        </a>


        {# =====================================================
           NAVIGATION PRINCIPALE
           ===================================================== #}

        <nav class="navbar-navigation" aria-label="Navigation principale">

            <a
                href="{{ path('app_home') }}"
                class="navbar-link is-active"
            >
                Accueil
            </a>

            <a href="{{ path('app_offers') }}" class="navbar-link">
                Nos offres
            </a>

            <a href="{{ path('app_results') }}" class="navbar-link">
                Résultats
            </a>

            <a href="{{ path('app_pronostics') }}" class="navbar-link">
                Pronostics
            </a>

            <a href="{{ path('app_vault') }}" class="navbar-link">
                NTS Vault
            </a>

            <a href="{{ path('app_blog') }}" class="navbar-link">
                Blog
            </a>

            <a href="{{ path('app_about') }}" class="navbar-link">
                À propos
            </a>

            <a href="{{ path('app_faq') }}" class="navbar-link">
                FAQ
            </a>

            <a href="{{ path('app_contact') }}" class="navbar-link">
                Contact
            </a>

        </nav>


        {# =====================================================
           ACTIONS
           ===================================================== #}

        <div class="navbar-actions">

            <button
                type="button"
                class="navbar-search"
                aria-label="Rechercher"
            >
                <svg
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                >
                    <circle
                        cx="11"
                        cy="11"
                        r="6.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    />

                    <path
                        d="M16 16L21 21"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                    />
                </svg>
            </button>

            {% if app.user %}

                <a href="{{ path('app_dashboard') }}" class="navbar-login">
                    Tableau de bord
                </a>

                <a href="{{ path('app_logout') }}" class="navbar-register">
                    Déconnexion
                </a>

            {% else %}

                <a href="{{ path('app_login') }}" class="navbar-login">
                    Se connecter
                </a>

                <a href="{{ path('app_register') }}" class="navbar-register">
                    S'inscrire
                </a>

            {% endif %}

        </div>


        {# =====================================================
           MOBILE
           ===================================================== #}

        <button
            type="button"
            class="navbar-toggle"
            aria-label="Ouvrir le menu"
            aria-expanded="false"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>

    </div>
</header>