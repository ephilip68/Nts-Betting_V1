<section class="pronostics-filter">

    <div class="pronostics-filter__container">

        {# =====================================================
           TABS
           ===================================================== #}

        <div class="pronostics-filter__tabs">

            <div class="pronostics-filter__tabs-list">

                <a
                    href="{{ path('app_pronostics', {sport: currentSport, competition: currentCompetition, type: currentBetType, confidence: currentConfidence, q: currentSearch, sort: currentSort}) }}"
                    class="pronostics-filter__tab {{ not currentAccess and not onlyFavorites ? 'pronostics-filter__tab--active' : '' }}"
                >
                    Tous les pronostics
                </a>

                <a
                    href="{{ path('app_pronostics', {sport: currentSport, access: 'free', competition: currentCompetition, type: currentBetType, confidence: currentConfidence, q: currentSearch, sort: currentSort}) }}"
                    class="pronostics-filter__tab {{ currentAccess == 'free' ? 'pronostics-filter__tab--active' : '' }}"
                >
                    Gratuits
                </a>

                <a
                    href="{{ path('app_pronostics', {sport: currentSport, access: 'vip', competition: currentCompetition, type: currentBetType, confidence: currentConfidence, q: currentSearch, sort: currentSort}) }}"
                    class="pronostics-filter__tab {{ currentAccess == 'vip' ? 'pronostics-filter__tab--active' : '' }}"
                >
                    VIP
                </a>

                {% if app.user %}
                    <a
                        href="{{ path('app_pronostics', {favorites: 1, sport: currentSport, competition: currentCompetition, type: currentBetType, confidence: currentConfidence, q: currentSearch, sort: currentSort}) }}"
                        class="pronostics-filter__tab {{ onlyFavorites ? 'pronostics-filter__tab--active' : '' }}"
                    >
                        Mes favoris
                    </a>
                {% endif %}

            </div>


            {# Bouton indépendant à droite #}

            <button
                type="button"
                class="pronostics-filter__help"
                data-pronostics-help-toggle
            >
                <span>Comment lire nos pronostics ?</span>
                <i class="fa-solid fa-circle-question"></i>
            </button>

        </div>


        <div class="pronostics-filter__help-panel" data-pronostics-help-panel hidden>
            <p><strong>Cote</strong> — le gain potentiel pour 1€ misé si le pronostic est gagnant.</p>
            <p><strong>Confiance</strong> — le niveau de conviction de l'analyse, de 1 à 5 points.</p>
            <p><strong><i class="fa-solid fa-lock"></i> Réservé VIP</strong> — pronostic et analyse visibles uniquement pour les membres VIP.</p>
        </div>


        {# =====================================================
           FILTERS
           ===================================================== #}

        <form class="pronostics-filter__filters" method="get" action="{{ path('app_pronostics') }}">

            {% if currentAccess %}<input type="hidden" name="access" value="{{ currentAccess }}">{% endif %}
            {% if onlyFavorites %}<input type="hidden" name="favorites" value="1">{% endif %}

            {# SPORT #}

            <div class="pronostics-filter__field">

                <label for="filter-sport">
                    Sport
                </label>

                <div class="pronostics-filter__select">

                    <select id="filter-sport" name="sport">

                        <option value="">Tous</option>
                        <option value="football" {{ currentSport == 'football' ? 'selected' : '' }}>Football</option>
                        <option value="basketball" {{ currentSport == 'basketball' ? 'selected' : '' }}>Basket</option>
                        <option value="tennis" {{ currentSport == 'tennis' ? 'selected' : '' }}>Tennis</option>

                    </select>

                    <i class="fa-solid fa-chevron-down"></i>

                </div>

            </div>


            {# COMPÉTITION #}

            <div class="pronostics-filter__field">

                <label for="filter-competition">
                    Compétition
                </label>

                <div class="pronostics-filter__select">

                    <select id="filter-competition" name="competition">

                        <option value="">Toutes</option>
                        {% for competition in availableCompetitions %}
                            <option value="{{ competition }}" {{ currentCompetition == competition ? 'selected' : '' }}>{{ competition }}</option>
                        {% endfor %}

                    </select>

                    <i class="fa-solid fa-chevron-down"></i>

                </div>

            </div>


            {# TYPE DE PARI #}

            <div class="pronostics-filter__field">

                <label for="filter-bet-type">
                    Type de pari
                </label>

                <div class="pronostics-filter__select">

                    <select id="filter-bet-type" name="type">

                        <option value="">Tous</option>
                        {% for betType in availableBetTypes %}
                            <option value="{{ betType }}" {{ currentBetType == betType ? 'selected' : '' }}>{{ betType }}</option>
                        {% endfor %}

                    </select>

                    <i class="fa-solid fa-chevron-down"></i>

                </div>

            </div>


            {# NIVEAU DE CONFIANCE #}

            <div class="pronostics-filter__field">

                <label for="filter-confidence">
                    Niveau de confiance
                </label>

                <div class="pronostics-filter__select">

                    <select id="filter-confidence" name="confidence">

                        <option value="">Tous</option>
                        <option value="5" {{ currentConfidence == 5 ? 'selected' : '' }}>Très élevé (5)</option>
                        <option value="4" {{ currentConfidence == 4 ? 'selected' : '' }}>Élevé (4+)</option>
                        <option value="3" {{ currentConfidence == 3 ? 'selected' : '' }}>Moyen (3+)</option>

                    </select>

                    <i class="fa-solid fa-chevron-down"></i>

                </div>

            </div>


            {# RECHERCHE #}

            <div class="pronostics-filter__search">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input
                    type="text"
                    id="filter-search"
                    name="q"
                    value="{{ currentSearch }}"
                    placeholder="Rechercher une équipe, un match..."
                >

            </div>


            {# FILTRER #}

            <button type="submit" class="pronostics-filter__button">

                <i class="fa-solid fa-magnifying-glass"></i>

                <span>
                    Filtrer
                </span>

            </button>

        </form>

    </div>

</section>
