<section class="pronostics-filter">

    <div class="pronostics-filter__container">

        {# =====================================================
           TABS
           ===================================================== #}

        <div class="pronostics-filter__tabs">

            <div class="pronostics-filter__tabs-list">

                <button
                    type="button"
                    class="pronostics-filter__tab pronostics-filter__tab--active"
                >
                    Tous les pronostics
                </button>

                <button
                    type="button"
                    class="pronostics-filter__tab"
                >
                    Gratuits
                </button>

                <button
                    type="button"
                    class="pronostics-filter__tab"
                >
                    VIP
                </button>

                <button
                    type="button"
                    class="pronostics-filter__tab"
                >
                    Mes favoris
                </button>

            </div>


            {# Bouton indépendant à droite #}

            <button
                type="button"
                class="pronostics-filter__help"
            >
                <span>Comment lire nos pronostics ?</span>
                <i class="fa-solid fa-circle-question"></i>
            </button>

        </div>


        {# =====================================================
           FILTERS
           ===================================================== #}

        <div class="pronostics-filter__filters">

            {# SPORT #}

            <div class="pronostics-filter__field">

                <label for="filter-sport">
                    Sport
                </label>

                <div class="pronostics-filter__select">

                    <select id="filter-sport">

                        <option value="">
                            Tous
                        </option>

                        <option value="football">
                            Football
                        </option>

                        <option value="basketball">
                            Basket
                        </option>

                        <option value="tennis">
                            Tennis
                        </option>

                    </select>

                    <i class="fa-solid fa-chevron-down"></i>

                </div>

            </div>


            {# COMPÉTITION #}

            <div class="pronostics-filter__field">

                <label for="filter-competition">
                    Compétition
                </label>

                <div class="pronostics-filter__select">

                    <select id="filter-competition">

                        <option value="">
                            Toutes
                        </option>

                        <option value="ligue-1">
                            Ligue 1
                        </option>

                        <option value="premier-league">
                            Premier League
                        </option>

                        <option value="liga">
                            Liga
                        </option>

                        <option value="bundesliga">
                            Bundesliga
                        </option>

                        <option value="serie-a">
                            Serie A
                        </option>

                    </select>

                    <i class="fa-solid fa-chevron-down"></i>

                </div>

            </div>


            {# PÉRIODE #}

            <div class="pronostics-filter__field">

                <label for="filter-period">
                    Période
                </label>

                <div class="pronostics-filter__select">

                    <select id="filter-period">

                        <option value="week">
                            Cette semaine
                        </option>

                        <option value="today">
                            Aujourd'hui
                        </option>

                        <option value="month">
                            Ce mois
                        </option>

                        <option value="all">
                            Toutes les périodes
                        </option>

                    </select>

                    <i class="fa-solid fa-chevron-down"></i>

                </div>

            </div>


            {# TYPE DE PARI #}

            <div class="pronostics-filter__field">

                <label for="filter-bet-type">
                    Type de pari
                </label>

                <div class="pronostics-filter__select">

                    <select id="filter-bet-type">

                        <option value="">
                            Tous
                        </option>

                        <option value="winner">
                            Vainqueur
                        </option>

                        <option value="double-chance">
                            Double chance
                        </option>

                        <option value="goals">
                            Buts
                        </option>

                        <option value="handicap">
                            Handicap
                        </option>

                    </select>

                    <i class="fa-solid fa-chevron-down"></i>

                </div>

            </div>


            {# NIVEAU DE CONFIANCE #}

            <div class="pronostics-filter__field">

                <label for="filter-confidence">
                    Niveau de confiance
                </label>

                <div class="pronostics-filter__select">

                    <select id="filter-confidence">

                        <option value="">
                            Tous
                        </option>

                        <option value="5">
                            Très élevé
                        </option>

                        <option value="4">
                            Élevé
                        </option>

                        <option value="3">
                            Moyen
                        </option>

                    </select>

                    <i class="fa-solid fa-chevron-down"></i>

                </div>

            </div>


            {# RECHERCHE #}

            <div class="pronostics-filter__search">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input
                    type="text"
                    id="filter-search"
                    placeholder="Rechercher une équipe, un match..."
                >

            </div>


            {# FILTRER #}

            <button
                type="button"
                class="pronostics-filter__button"
            >

                <i class="fa-solid fa-magnifying-glass"></i>

                <span>
                    Filtrer
                </span>

            </button>

        </div>

    </div>

</section>