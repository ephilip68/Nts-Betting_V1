<!-- =========================================================
     SECTION STATISTIQUES / TELEGRAM
     ========================================================= -->

<section class="stats-telegram-section">

    <div class="stats-telegram-section__container">


        <!-- =====================================================
             STATISTIQUES
             ===================================================== -->

        <div class="stats-telegram-section__stats">

            <div class="stats-telegram-section__header">

                <h2 class="stats-telegram-section__title">
                    Nos statistiques sur ce mois
                </h2>

            </div>


            <div class="stats-telegram-section__grid">


                <!-- STAT 1 -->

                <article class="stats-telegram-section__stat">

                    <div class="stats-telegram-section__stat-icon">

                        <i class="fa-solid fa-bullseye"></i>

                    </div>

                    <div class="stats-telegram-section__stat-content">

                        <strong class="stats-telegram-section__stat-value">
                            78%
                        </strong>

                        <span class="stats-telegram-section__stat-label">
                            Taux de réussite
                        </span>

                    </div>

                </article>


                <!-- STAT 2 -->

                <article class="stats-telegram-section__stat">

                    <div class="stats-telegram-section__stat-icon">

                        <i class="fa-solid fa-chart-line"></i>

                    </div>

                    <div class="stats-telegram-section__stat-content">

                        <strong class="stats-telegram-section__stat-value">
                            +24.5
                        </strong>

                        <span class="stats-telegram-section__stat-label">
                            Gains du mois
                        </span>

                    </div>

                </article>


                <!-- STAT 3 -->

                <article class="stats-telegram-section__stat">

                    <div class="stats-telegram-section__stat-icon">

                        <i class="fa-solid fa-chart-simple"></i>

                    </div>

                    <div class="stats-telegram-section__stat-content">

                        <strong class="stats-telegram-section__stat-value">
                            3.12
                        </strong>

                        <span class="stats-telegram-section__stat-label">
                            Cote moyenne
                        </span>

                    </div>

                </article>


                <!-- STAT 4 -->

                <article class="stats-telegram-section__stat">

                    <div class="stats-telegram-section__stat-icon">

                        <i class="fa-solid fa-coins"></i>

                    </div>

                    <div class="stats-telegram-section__stat-content">

                        <strong class="stats-telegram-section__stat-value">
                            +12 580 €
                        </strong>

                        <span class="stats-telegram-section__stat-label">
                            Bénéfice estimé
                        </span>

                    </div>

                </article>


            </div>

        </div>


        <!-- =====================================================
             TÉMOIGNAGE
             ===================================================== -->

        <article class="stats-telegram-section__testimonial">

            <div class="stats-telegram-section__testimonial-quote">

                <i class="fa-solid fa-quote-left"></i>

            </div>

            <p class="stats-telegram-section__testimonial-text">

                « La différence entre un pari gagnant
                et le nôtre, c'est l'accès aux bonnes
                informations. »

            </p>

            <span class="stats-telegram-section__testimonial-author">
                NTS Betting
            </span>

        </article>


        <!-- =====================================================
             TELEGRAM
             ===================================================== -->

        <article class="stats-telegram-section__telegram">

            <div class="stats-telegram-section__telegram-content">

                <h3 class="stats-telegram-section__telegram-title">
                    Rejoignez notre groupe Telegram
                </h3>

                <p class="stats-telegram-section__telegram-text">
                    Recevez nos pronostics, nos analyses
                    et nos résultats en temps réel.
                </p>

                <a
                    href="#"
                    class="stats-telegram-section__telegram-button"
                >

                    <span>
                        Nous rejoindre
                    </span>

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>


            <div class="stats-telegram-section__telegram-visual">

                <div class="stats-telegram-section__telegram-phone">

                    <i class="fa-brands fa-telegram"></i>

                </div>

                <div class="stats-telegram-section__telegram-phone">

                    <i class="fa-brands fa-telegram"></i>

                </div>

            </div>

        </article>


    </div>

</section>