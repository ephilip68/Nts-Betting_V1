<section class="pronostics-section">

    <div class="pronostics-section__container">

        <!-- COLONNE GAUCHE -->
        <div class="pronostics-section__main">

            <div class="pronostics-section__header">

                <h2 class="pronostics-section__title">
                    Pronostics ({{ totalPronostics }})
                </h2>

                <div class="pronostics-section__sort">
                    <select>
                        <option>Plus récents</option>
                        <option>Plus anciens</option>
                    </select>

                    <i class="fa-solid fa-chevron-down"></i>
                </div>

            </div>


            <div class="pronostics-list">

                {% for pronostic in pronostics %}

                    {# Un pronostic VIP est verrouillé pour les non-abonnés #}
                    {% set isLocked = pronostic.vip and not isVip %}

                    <div class="pronostics-list__item{{ isLocked ? ' pronostics-list__item--locked' : '' }}">

                        <!-- MATCH -->
                        <div class="pronostics-list__match">

                            <div class="pronostics-list__sport-icon">
                                <i class="fa-solid fa-{{ pronostic.sport == 'basketball' ? 'basketball' : (pronostic.sport == 'tennis' ? 'table-tennis-paddle-ball' : 'futbol') }}"></i>
                            </div>

                            <div class="pronostics-list__match-info">

                                <span class="pronostics-list__competition">
                                    {{ pronostic.competition }}
                                </span>

                                <div class="pronostics-list__teams">
                                    <span>{{ pronostic.teamHome }}</span>

                                    <span class="pronostics-list__vs">
                                        VS
                                    </span>

                                    <span>{{ pronostic.teamAway }}</span>
                                </div>

                            </div>

                        </div>


                        <!-- PRONOSTIC -->
                        <div class="pronostics-list__bet">

                            <span class="pronostics-list__bet-type">
                                {{ pronostic.betType }}
                            </span>

                            <span class="pronostics-list__bet-value">
                                {% if isLocked %}
                                    <i class="fa-solid fa-lock"></i> Réservé VIP
                                {% else %}
                                    {{ pronostic.betValue }}
                                {% endif %}
                            </span>

                        </div>

                        <!-- COTE -->
                        <div class="pronostics-list__odds">

                            <span class="pronostics-list__meta-label">
                                Cote
                            </span>

                            <strong class="pronostics-list__odds-value">
                                {{ isLocked ? '—' : pronostic.odds }}
                            </strong>

                        </div>


                        <!-- CONFIANCE -->
                        <div class="pronostics-list__confidence">

                            <span class="pronostics-list__meta-label">
                                Confiance
                            </span>

                            <div class="pronostics-list__confidence-dots">

                                {% for dot in 1..5 %}
                                    <span class="{{ dot <= pronostic.confidence ? 'is-active' : '' }}"></span>
                                {% endfor %}

                            </div>

                        </div>


                        <!-- ACTION -->
                        <div class="pronostics-list__action">

                            {% if isLocked %}
                                <a href="{{ path('app_offers') }}" class="pronostics-list__button">
                                    <i class="fa-solid fa-crown"></i> VIP
                                </a>
                            {% else %}
                                <button class="pronostics-list__button">
                                    Voir
                                </button>
                            {% endif %}

                        </div>

                    </div>

                {% else %}

                    <p class="pronostics-list__empty">
                        Aucun pronostic ne correspond à ces filtres pour le moment.
                    </p>

                {% endfor %}

            </div>


            {% if pageCount > 1 %}

                <div class="pronostics-pagination">

                    <button {{ page <= 1 ? 'disabled' : '' }}>
                        <a href="{{ path('app_pronostics', {sport: currentSport, access: currentAccess, page: max(page - 1, 1)}) }}">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    </button>

                    {% for p in 1..pageCount %}
                        <a href="{{ path('app_pronostics', {sport: currentSport, access: currentAccess, page: p}) }}">
                            <button class="{{ p == page ? 'is-active' : '' }}">{{ p }}</button>
                        </a>
                    {% endfor %}

                    <button {{ page >= pageCount ? 'disabled' : '' }}>
                        <a href="{{ path('app_pronostics', {sport: currentSport, access: currentAccess, page: min(page + 1, pageCount)}) }}">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </button>

                </div>

            {% endif %}

        </div>


        <!-- COLONNE DROITE -->
        <aside class="pronostics-sidebar">

            {% if featured %}

                <!-- PRONOSTIC DU JOUR -->

                <article class="pronostics-card">

                    {# HEADER #}

                    <div class="pronostics-card__header">

                        <div class="pronostics-card__title">

                            <i class="fa-solid fa-star"></i>

                            <span>
                                Pronostic du jour
                            </span>

                        </div>

                        <span class="pronostics-card__badge">
                            Gratuit
                        </span>

                    </div>


                    {# CORPS #}

                    <div class="pronostics-card__body">

                        {# COMPÉTITION + DATE #}

                        <div class="pronostics-card__match-info">

                            <div class="pronostics-card__competition">

                                <i class="fa-solid fa-futbol"></i>

                                <span>
                                    {{ featured.competition }}
                                </span>

                            </div>

                            <div class="pronostics-card__date">
                                {{ featured.matchDate|date('d F Y · H:i') }}
                            </div>

                        </div>


                        {# ÉQUIPES #}

                        <div class="pronostics-card__teams">

                            <div class="pronostics-card__team">

                                <img
                                    src="{{ featured.teamHomeLogo ?: '/images/resultats/teams/default.png' }}"
                                    alt="{{ featured.teamHome }}"
                                >

                                <span>
                                    {{ featured.teamHome }}
                                </span>

                            </div>


                            <div class="pronostics-card__vs">
                                VS
                            </div>


                            <div class="pronostics-card__team">

                                <img
                                    src="{{ featured.teamAwayLogo ?: '/images/resultats/teams/default.png' }}"
                                    alt="{{ featured.teamAway }}"
                                >

                                <span>
                                    {{ featured.teamAway }}
                                </span>

                            </div>

                        </div>


                        {# INFORMATIONS #}

                        <div class="pronostics-card__stats">

                            {# PRONOSTIC #}

                            <div class="pronostics-card__stat">

                                <span class="pronostics-card__stat-label">
                                    <i class="fa-solid fa-star"></i>
                                    Pronostic
                                </span>

                                <strong class="pronostics-card__stat-value">
                                    {{ featured.betType }} : {{ featured.betValue }}
                                </strong>

                            </div>


                            {# COTE #}

                            <div class="pronostics-card__stat">

                                <span class="pronostics-card__stat-label">
                                    Cote
                                </span>

                                <strong class="pronostics-card__stat-value">
                                    {{ featured.odds }}
                                </strong>

                            </div>


                            {# CONFIANCE #}

                            <div class="pronostics-card__stat pronostics-card__stat--confidence">

                                <span class="pronostics-card__stat-label">
                                    Niveau de confiance
                                </span>

                                <div class="pronostics-card__confidence">

                                    {% for dot in 1..5 %}
                                        <span class="{{ dot <= featured.confidence ? 'is-active' : '' }}"></span>
                                    {% endfor %}

                                </div>

                            </div>

                        </div>


                        {# ANALYSE #}

                        {% if featured.analysis %}

                            <div class="pronostics-card__analysis-block">

                                <h3 class="pronostics-card__analysis-title">
                                    Notre analyse
                                </h3>

                                <p class="pronostics-card__analysis">
                                    {{ featured.analysis }}
                                </p>

                            </div>

                        {% endif %}

                    </div>

                </article>

            {% endif %}


            {% if not isVip %}

                <!-- VIP -->

                <article class="pronostics-card pronostics-card--vip">

                    <!-- EN-TÊTE VIP -->
                    <div class="pronostics-card--vip__head">

                        <div class="pronostics-card--vip__icon">
                            <i class="fa-solid fa-crown"></i>
                        </div>

                        <h3 class="pronostics-card--vip__title">
                            Accès réservé aux membres VIP
                        </h3>

                        <p class="pronostics-card--vip__text">
                            {% if nextVip %}
                                Un prochain pronostic VIP ({{ nextVip.competition }}) est disponible uniquement pour nos membres VIP.
                            {% else %}
                                Cette analyse détaillée est disponible uniquement pour nos membres VIP.
                            {% endif %}
                        </p>

                    </div>


                    <!-- FEATURES -->
                    <div class="pronostics-card--vip__content">

                        <ul class="pronostics-card--vip__features">

                            <li>
                                <i class="fa-solid fa-circle-check"></i>
                                <span>Analyse complète du match</span>
                            </li>

                            <li>
                                <i class="fa-solid fa-circle-check"></i>
                                <span>Statistiques avancées</span>
                            </li>

                            <li>
                                <i class="fa-solid fa-circle-check"></i>
                                <span>Conseil de mise (bankroll)</span>
                            </li>

                            <li>
                                <i class="fa-solid fa-circle-check"></i>
                                <span>Scénarios alternatifs</span>
                            </li>

                            <li>
                                <i class="fa-solid fa-circle-check"></i>
                                <span>Notre avis d'expert</span>
                            </li>

                        </ul>

                    </div>


                    <!-- CTA -->
                    <div class="pronostics-card--vip__footer">

                        <a href="{{ path('app_offers') }}" class="pronostics-card--vip__button">
                            <span>Découvrir nos offres VIP</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                    </div>

                </article>

            {% endif %}

        </aside>

    </div>

</section>
