<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Vérification de votre adresse e-mail — NTS Betting</title>
</head>

<body style="
    margin:0;
    padding:0;
    background-color:#020b14;
    font-family:Arial, Helvetica, sans-serif;
    color:#ffffff;
">

<table width="100%" cellpadding="0" cellspacing="0" border="0"
       style="background-color:#020b14; margin:0; padding:35px 15px;">

    <tr>
        <td align="center">

            <!-- CONTAINER -->
            <table width="600" cellpadding="0" cellspacing="0" border="0"
                   style="
                        width:100%;
                        max-width:600px;
                        background-color:#061522;
                        border:1px solid #1d3a50;
                        border-radius:10px;
                        overflow:hidden;
                   ">

                <!-- HEADER -->
                <tr>
                    <td align="center"
                        style="
                            padding:28px 25px;
                            border-bottom:1px solid #1d3a50;
                        ">

                        {# 
                            Si ton logo est disponible publiquement,
                            tu peux remplacer le texte ci-dessous par une image.
                        #}

                        <div style="
                            font-size:28px;
                            font-weight:bold;
                            letter-spacing:2px;
                            color:#ffffff;
                        ">
                            👑 NTS
                        </div>

                        <div style="
                            margin-top:3px;
                            font-size:11px;
                            letter-spacing:4px;
                            color:#DDB219;
                            font-weight:bold;
                        ">
                            BETTING
                        </div>

                    </td>
                </tr>


                <!-- CONTENT -->
                <tr>
                    <td align="center"
                        style="padding:45px 40px 40px 40px;">

                        <!-- CROWN -->
                        <div style="
                            font-size:34px;
                            line-height:1;
                            margin-bottom:20px;
                        ">
                            👑
                        </div>


                        <!-- ICON -->
                        <table cellpadding="0" cellspacing="0" border="0"
                               style="margin:0 auto 22px auto;">
                            <tr>
                                <td align="center"
                                    style="
                                        width:72px;
                                        height:72px;
                                        border:2px solid #ffffff;
                                        border-radius:12px;
                                        font-size:34px;
                                        color:#ffffff;
                                    ">
                                    ✉
                                </td>
                            </tr>
                        </table>


                        <!-- TITLE -->
                        <h1 style="
                            margin:0 0 18px 0;
                            font-family:Georgia, 'Times New Roman', serif;
                            font-size:27px;
                            line-height:1.25;
                            color:#ffffff;
                            letter-spacing:.3px;
                        ">
                            BIENVENUE SUR NTS BETTING !
                        </h1>


                        <!-- TEXT -->
                        <p style="
                            margin:0 0 12px 0;
                            font-size:15px;
                            line-height:1.7;
                            color:#b8c7d3;
                        ">
                            Merci pour votre inscription.
                        </p>

                        <p style="
                            margin:0 0 30px 0;
                            font-size:15px;
                            line-height:1.7;
                            color:#b8c7d3;
                        ">
                            Pour activer votre compte et accéder à
                            toutes les fonctionnalités de NTS Betting,
                            veuillez confirmer votre adresse e-mail.
                        </p>


                        <!-- BUTTON -->
                        <table cellpadding="0" cellspacing="0" border="0"
                               style="margin:0 auto 30px auto;">

                            <tr>
                                <td align="center"
                                    style="
                                        background-color:#DDB219;
                                        border-radius:5px;
                                    ">

                                    <a href="{{ signedUrl }}"
                                       style="
                                            display:inline-block;
                                            padding:15px 30px;
                                            color:#07111a;
                                            font-size:14px;
                                            font-weight:bold;
                                            text-decoration:none;
                                            letter-spacing:.2px;
                                       ">
                                        VÉRIFIER MON ADRESSE E-MAIL
                                        &nbsp;&nbsp;→
                                    </a>

                                </td>
                            </tr>

                        </table>


                        <!-- INFO BOX -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0"
                               style="
                                    background-color:#091d2c;
                                    border:1px solid #29465b;
                                    border-radius:5px;
                               ">

                            <tr>
                                <td style="
                                    padding:17px 20px;
                                    text-align:center;
                                ">

                                    <span style="
                                        color:#DDB219;
                                        font-size:15px;
                                    ">
                                        ⏱
                                    </span>

                                    <span style="
                                        color:#b8c7d3;
                                        font-size:13px;
                                        line-height:1.6;
                                    ">
                                        Ce lien est valable pendant
                                        <strong style="color:#ffffff;">
                                            {{ expires_in|default('1 heure') }}
                                        </strong>.
                                    </span>

                                </td>
                            </tr>

                        </table>


                        <!-- SECURITY MESSAGE -->
                        <p style="
                            margin:28px 0 0 0;
                            font-size:12px;
                            line-height:1.6;
                            color:#7891a3;
                        ">
                            Si vous n'êtes pas à l'origine de cette inscription,
                            vous pouvez simplement ignorer cet e-mail.
                        </p>

                    </td>
                </tr>


                <!-- FOOTER -->
                <tr>
                    <td align="center"
                        style="
                            padding:24px 25px;
                            border-top:1px solid #1d3a50;
                            background-color:#04111c;
                        ">

                        <p style="
                            margin:0 0 8px 0;
                            font-size:11px;
                            color:#7891a3;
                        ">
                            © {{ "now"|date("Y") }} NTS Betting.
                            Tous droits réservés.
                        </p>

                        <p style="
                            margin:0;
                            font-size:10px;
                            color:#526b7d;
                        ">
                            Pronostiquer · Analyser · Progresser
                        </p>

                    </td>
                </tr>

            </table>

        </td>
    </tr>

</table>

</body>
</html>