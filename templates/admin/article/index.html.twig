{% extends 'admin/base.html.twig' %}

{% block title %}Blog — Admin{% endblock %}
{% block page_title %}Articles{% endblock %}

{% block body %}

    <div style="display:flex; justify-content:flex-end; margin-bottom:16px;">
        <a href="{{ path('admin_article_new') }}" class="btn"><i class="fa-solid fa-plus"></i> Nouvel article</a>
    </div>

    <div class="admin-table-wrapper">
    <table>
        <thead>
            <tr>
                <th>Titre</th>
                <th>Catégorie</th>
                <th>Auteur</th>
                <th>Statut</th>
                <th>Publié le</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for article in articles %}
                <tr>
                    <td>{{ article.title }}{% if article.featured %} ⭐{% endif %}</td>
                    <td>{{ article.categoryLabel }}</td>
                    <td>{{ article.author }}</td>
                    <td>
                        <span class="badge badge-{{ article.status }}">{{ article.status }}</span>
                    </td>
                    <td>{{ article.publishedAt ? article.publishedAt|date('d/m/Y') : '—' }}</td>
                    <td style="white-space:nowrap;">
                        <a href="{{ path('admin_article_edit', {id: article.id}) }}" class="btn btn-secondary" style="padding:6px 12px; font-size:13px;">Modifier</a>
                        <form action="{{ path('admin_article_delete', {id: article.id}) }}" method="post" style="display:inline;" onsubmit="return confirm('Supprimer cet article ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-article-' ~ article.id) }}">
                            <button type="submit" class="btn btn-danger" style="padding:6px 12px; font-size:13px;">Suppr.</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6">Aucun article pour le moment.</td></tr>
            {% endfor %}
        </tbody>
    </table>
    </div>

{% endblock %}
