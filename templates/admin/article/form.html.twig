{% extends 'admin/base.html.twig' %}

{% block title %}{{ article.id ? 'Modifier' : 'Nouvel' }} article — Admin{% endblock %}
{% block page_title %}{{ article.id ? "Modifier l'article" : 'Nouvel article' }}{% endblock %}

{% block body %}

    {% if article.coverImage %}
        <p><img src="{{ asset(article.coverImage) }}" alt="" style="max-width:240px; border-radius:8px;"></p>
    {% endif %}

    {{ form_start(form, {attr: {class: 'admin-form', enctype: 'multipart/form-data'}}) }}
        {{ form_row(form.title) }}
        {{ form_row(form.slug) }}
        {{ form_row(form.excerpt) }}
        {{ form_row(form.content) }}
        {{ form_row(form.category) }}
        {{ form_row(form.coverImageFile) }}
        {{ form_row(form.author) }}
        {{ form_row(form.status) }}

        <div class="checkbox-row">{{ form_widget(form.isFeatured) }} {{ form_label(form.isFeatured) }}</div>

        <div class="actions-row">
            <button type="submit" class="btn">Enregistrer</button>
            <a href="{{ path('admin_article_index') }}" class="btn btn-secondary">Annuler</a>
        </div>
    {{ form_end(form) }}

{% endblock %}
