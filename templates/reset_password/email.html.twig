<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Réinitialisation de votre mot de passe — NTS Betting</title>
</head>

<body style="
    margin:0;
    padding:0;
    background:#020b14;
    font-family:Arial, Helvetica, sans-serif;
    color:#e5e7eb;
">

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#020b14;">
    <tr>
        <td align="center" style="padding:40px 20px;">

            <!-- CONTAINER -->
            <table
                width="600"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                    max-width:600px;
                    width:100%;
                    background:#061522;
                    border:1px solid #263b4d;
                    border-radius:8px;
                    overflow:hidden;
                "
            >

                <!-- HEADER -->
                <tr>
                    <td
                        align="center"
                        style="
                            padding:28px 30px;
                            background:#030f1b;
                            border-bottom:1px solid #263b4d;
                        "
                    >
                        <img
                            src="{{ absolute_url(asset('images/logo/logo.png')) }}"
                            alt="NTS Betting"
                            width="110"
                            style="
                                display:block;
                                width:110px;
                                max-width:110px;
                                height:auto;
                                border:0;
                            "
                        >
                    </td>
                </tr>

                <!-- CONTENT -->
                <tr>
                    <td style="padding:40px 45px;">

                        <div
                            style="
                                text-align:center;
                                color:#DDB219;
                                font-size:38px;
                                line-height:1;
                                margin-bottom:18px;
                            "
                        >
                            🔐
                        </div>

                        <h1
                            style="
                                margin:0 0 18px;
                                text-align:center;
                                color:#ffffff;
                                font-family:Georgia, 'Times New Roman', serif;
                                font-size:25px;
                                line-height:1.3;
                            "
                        >
                            RÉINITIALISATION DU MOT DE PASSE
                        </h1>

                        <p
                            style="
                                margin:0 0 25px;
                                text-align:center;
                                color:#aebbc7;
                                font-size:14px;
                                line-height:1.7;
                            "
                        >
                            Vous avez demandé à réinitialiser le mot de passe
                            de votre compte <strong style="color:#ffffff;">NTS Betting</strong>.
                        </p>

                        <!-- BUTTON -->
                        <table
                            width="100%"
                            cellpadding="0"
                            cellspacing="0"
                            border="0"
                        >
                            <tr>
                                <td align="center" style="padding:5px 0 30px;">

                                    <a
                                        href="{{ url('app_reset_password', {token: resetToken.token}) }}"
                                        style="
                                            display:inline-block;
                                            padding:14px 28px;
                                            background:#DDB219;
                                            color:#07121d;
                                            text-decoration:none;
                                            font-size:13px;
                                            font-weight:bold;
                                            border-radius:4px;
                                        "
                                    >
                                        RÉINITIALISER MON MOT DE PASSE →
                                    </a>

                                </td>
                            </tr>
                        </table>

                        <!-- EXPIRATION -->
                        <table
                            width="100%"
                            cellpadding="0"
                            cellspacing="0"
                            border="0"
                            style="
                                background:#0a1b29;
                                border:1px solid #35495a;
                                border-radius:4px;
                            "
                        >
                            <tr>
                                <td
                                    style="
                                        padding:14px 18px;
                                        text-align:center;
                                        color:#aebbc7;
                                        font-size:12px;
                                        line-height:1.5;
                                    "
                                >
                                    ⏱
                                    Ce lien est valable pendant
                                    <strong style="color:#ffffff;">
                                        {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}
                                    </strong>.
                                </td>
                            </tr>
                        </table>

                        <p
                            style="
                                margin:28px 0 0;
                                color:#7f909f;
                                font-size:11px;
                                line-height:1.7;
                                text-align:center;
                            "
                        >
                            Si vous n'êtes pas à l'origine de cette demande,
                            vous pouvez simplement ignorer cet e-mail.
                        </p>

                    </td>
                </tr>

                <!-- FOOTER -->
                <tr>
                    <td
                        align="center"
                        style="
                            padding:22px 30px;
                            background:#030f1b;
                            border-top:1px solid #263b4d;
                        "
                    >
                        <p
                            style="
                                margin:0;
                                color:#667887;
                                font-size:10px;
                                line-height:1.6;
                            "
                        >
                            © {{ "now"|date("Y") }} NTS Betting.
                            Tous droits réservés.
                        </p>

                        <p
                            style="
                                margin:5px 0 0;
                                color:#4f6170;
                                font-size:9px;
                            "
                        >
                            Pronostiquer · Analyser · Progresser
                        </p>
                    </td>
                </tr>

            </table>

        </td>
    </tr>
</table>

</body>
</html>