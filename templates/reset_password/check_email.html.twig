{% extends 'base.html.twig' %}

{% block title %}Vérifiez votre e-mail — NTS Betting{% endblock %}

{% block body_class %}page-check-email{% endblock %}

{% block body %}

    {% include 'components/_navbar.html.twig' %}

    <main class="auth-page check-email-page">

        <div class="check-email-background"></div>

        {# FEATURES À GAUCHE #}
        <div class="check-email-features">

            <div class="check-email-feature">
                <div class="check-email-feature__icon">
                    <i class="fa-solid fa-envelope"></i>
                </div>

                <div class="check-email-feature__content">
                    <strong>Vérifiez votre boîte mail</strong>
                    <span>Le lien arrive généralement en quelques secondes.</span>
                </div>
            </div>

            <div class="check-email-feature">
                <div class="check-email-feature__icon">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>

                <div class="check-email-feature__content">
                    <strong>Lien sécurisé</strong>
                    <span>Le lien de réinitialisation est temporaire.</span>
                </div>
            </div>

            <div class="check-email-feature">
                <div class="check-email-feature__icon">
                    <i class="fa-solid fa-lock"></i>
                </div>

                <div class="check-email-feature__content">
                    <strong>Votre compte reste protégé</strong>
                    <span>Ne partagez jamais votre lien de réinitialisation.</span>
                </div>
            </div>

        </div>

        {# CARTE #}
        <div class="check-email-card">

            <div class="check-email-icon">
                <i class="fa-solid fa-envelope-circle-check"></i>
            </div>

            <h1>VÉRIFIEZ VOTRE E-MAIL</h1>

            <p class="check-email-description">
                Si un compte existe avec cette adresse,
                vous allez recevoir un lien pour réinitialiser
                votre mot de passe.
            </p>

            <div class="check-email-notice">
                <i class="fa-solid fa-clock"></i>

                <span>
                    Le lien est valable pendant
                    <strong>1 heure</strong>.
                </span>
            </div>

            <a href="{{ path('app_login') }}" class="check-email-back">
                Retour à la connexion
            </a>

        </div>

    </main>

    {% include 'components/_footer.html.twig' %}

{% endblock %}